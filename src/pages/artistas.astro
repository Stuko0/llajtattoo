---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import NewsSec from "../components/NewsSec.astro";
---

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Comunidad de tatuadores de Cochabamba, Bolivia. Conoce a los mejores artistas del tattoo en nuestra plataforma.">
<title>Llajtattoo | Artistas</title>
<link rel="stylesheet" href="/globals.css">
<link rel="stylesheet" href="/styleguide.css">
<script is:inline src="https://cdn.tailwindcss.com"></script>
<script is:inline>
tailwind.config = {
      corePlugins: { preflight: false },
      theme: {
        extend: {
          boxShadow: {
            "m3-elevation-light-5": "var(--m3-elevation-light-5)"
          }
        }
      },
      plugins: []
    };
  </script>
</head>
<body class="m-0 bg-white text-black">
<Navbar currentPage="artistas" />

<main>
  <!-- Glass-morphism Hero Section -->
  <section id="inicio" class="mx-auto w-full max-w-[1308px] px-4 pb-8 pt-4 sm:px-6 lg:px-0 lg:pb-16 lg:pt-[60px]" aria-labelledby="community-title">
    <div class="overflow-hidden border border-transparent bg-[#ffffff1f] shadow-[0px_4px_4px_#00000040]">
      <!-- Desktop: grid 2 columnas -->
      <div class="hidden lg:grid lg:grid-cols-2 lg:gap-x-9 lg:pl-3.5 lg:pr-[53px]">
        <img
          class="row-span-2 h-full min-h-[512px] w-full object-cover"
          src="/images/hero.png"
          alt="Ilustración decorativa de tatuaje"
        >
        <div class="flex flex-col justify-center self-end">
          <h1 id="community-title" class="max-w-[775px] self-end text-right font-['David_Libre',Helvetica] text-5xl font-bold leading-[61px]">
            EN NUESTRA COMUNIDAD ESTÁN LOS MEJORES TATUADORES DE COCHABAMBA
          </h1>
          <p class="mt-6 max-w-[618px] self-end text-right font-['Inter',Helvetica] text-base font-normal leading-[29px] text-[#000000b2]">
            ¡Bienvenido a nuestra comunidad de tatuadores! Este es un espacio diseñado para compartir conocimientos, exhibir talento y fomentar la colaboración entre artistas. Conecta con profesionales del tatuaje, descubre nuevas oportunidades y forma parte de una red creativa comprometida con el crecimiento y la excelencia artística.
          </p>
        </div>
      </div>
      <!-- Mobile: stack vertical -->
      <div class="lg:hidden">
        <img
          class="h-48 w-full object-cover"
          src="/images/hero.png"
          alt="Ilustración decorativa de tatuaje"
        >
        <div class="px-5 py-6 sm:px-10">
          <h1 class="font-['David_Libre',Helvetica] text-2xl font-bold leading-[1.1] sm:text-4xl">
            EN NUESTRA COMUNIDAD ESTÁN LOS MEJORES TATUADORES DE COCHABAMBA
          </h1>
          <p class="mt-4 text-justify font-['Inter',Helvetica] text-[10px] font-normal leading-4 text-[#000000b2] sm:text-sm sm:leading-6">
            ¡Bienvenido a nuestra comunidad de tatuadores! Este es un espacio diseñado para compartir conocimientos, exhibir talento y fomentar la colaboración entre artistas. Conecta con profesionales del tatuaje, descubre nuevas oportunidades y forma parte de una red creativa comprometida con el crecimiento y la excelencia artística.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Artists Section with Staggered Don Juan -->
  <section id="artistas" class="relative mx-auto w-full overflow-hidden px-4 py-8 text-center sm:px-6 lg:px-0 lg:py-16" aria-labelledby="artists-title">
    <!-- Background decorative -->
    <img
      class="pointer-events-none absolute bottom-0 left-0 hidden w-28 object-contain opacity-40 lg:block"
      src="/images/assets/dragon-in-black.png"
      alt=""
    >
    <img
      class="pointer-events-none absolute right-0 top-1/3 hidden w-32 object-contain opacity-30 lg:block"
      src="/images/assets/flowers-in-black.png"
      alt=""
    >

    <h2 id="artists-title" class="font-['David_Libre',Helvetica] text-2xl font-bold leading-none sm:text-3xl lg:text-[70px] lg:leading-[72px]">
      Nuestros Artistas
    </h2>
    <p class="mx-auto mt-3 max-w-[525px] font-['Inter',Helvetica] text-[10px] font-normal leading-4 sm:text-sm sm:leading-6 lg:mt-6 lg:text-base lg:leading-[29px]">
      Conoce a los artistas que forman parte de nuestra comunidad. Explora sus perfiles, descubre su experiencia y encuentra al tatuador que mejor se adapte a tu estilo.
    </p>

    <!-- Artist Grid: 5 columnas en desktop, Don Juan más abajo -->
    <div class="mx-auto mt-8 grid max-w-[1111px] grid-cols-2 gap-6 sm:grid-cols-3 lg:mt-12 lg:grid-cols-5 lg:gap-0">
      <!-- Fabian Morales -->
      <article class="flex flex-col items-center text-center">
        <img class="h-24 w-24 rounded-full object-cover sm:h-28 sm:w-28 lg:h-[156px] lg:w-[156px]" src="/images/assets/Profe Tattoo.png" alt="Fabian Morales, Profe Tattoo">
        <h3 class="mt-3 font-['David_Libre',Helvetica] text-sm font-bold leading-5 sm:text-base lg:mt-4 lg:text-xl lg:leading-6">
          Fabian Morales<br>PROFE TATTOO
        </h3>
        <a href="#fabian-morales" class="mt-2 inline-block rounded-lg bg-[#101a24] px-8 py-2.5 font-['David_Libre',Helvetica] text-base font-medium text-white hover:opacity-85 transition-opacity">
          Ver Perfil
        </a>
      </article>

      <!-- Ignacio Orihuela -->
      <article class="flex flex-col items-center text-center">
        <img class="h-24 w-24 rounded-full object-cover sm:h-28 sm:w-28 lg:h-[156px] lg:w-[156px]" src="/images/assets/Profe Tattoo.png" alt="Ignacio Orihuela, Pistacho Tattoo">
        <h3 class="mt-3 font-['David_Libre',Helvetica] text-sm font-bold leading-5 sm:text-base lg:mt-4 lg:text-xl lg:leading-6">
          Ignacio Orihuela<br>PISTACHO TTOO
        </h3>
        <a href="#pistacho-tattoo" class="mt-2 inline-block rounded-lg bg-[#101a24] px-8 py-2.5 font-['David_Libre',Helvetica] text-base font-medium text-white hover:opacity-85 transition-opacity">
          Ver Perfil
        </a>
      </article>

      <!-- Juan Maria Savedra -->
      <article class="flex flex-col items-center text-center">
        <img class="h-24 w-24 rounded-full object-cover sm:h-28 sm:w-28 lg:h-[156px] lg:w-[156px]" src="/images/assets/Don Juan Caballero.png" alt="Juan Maria Savedra, Juanma">
        <h3 class="mt-3 font-['David_Libre',Helvetica] text-sm font-bold leading-5 sm:text-base lg:mt-4 lg:text-xl lg:leading-6">
          Juan Maria Savedra<br>JUANMA
        </h3>
        <a href="#juanma" class="mt-2 inline-block rounded-lg bg-[#101a24] px-8 py-2.5 font-['David_Libre',Helvetica] text-base font-medium text-white hover:opacity-85 transition-opacity">
          Ver Perfil
        </a>
      </article>

      <!-- Juan Caballero - STAGGERED (más abajo que los demás) -->
      <article class="flex flex-col items-center text-center lg:mt-[110px]">
        <img class="h-24 w-24 rounded-full object-cover sm:h-28 sm:w-28 lg:h-[156px] lg:w-[156px]" src="/images/assets/Don Juan Caballero.png" alt="Juan Caballero, Don Juan">
        <h3 class="mt-3 font-['David_Libre',Helvetica] text-sm font-bold leading-5 sm:text-base lg:mt-4 lg:text-xl lg:leading-6">
          Juan Caballero<br>DON JUAN
        </h3>
        <a href="#don-juan" class="mt-2 inline-block rounded-lg bg-[#101a24] px-8 py-2.5 font-['David_Libre',Helvetica] text-base font-medium text-white hover:opacity-85 transition-opacity">
          Ver Perfil
        </a>
      </article>

      <!-- Natalia Lazzo -->
      <article class="flex flex-col items-center text-center">
        <img class="h-24 w-24 rounded-full object-cover sm:h-28 sm:w-28 lg:h-[156px] lg:w-[156px]" src="/images/assets/Black Kitty.png" alt="Natalia Lazzo, Blackitty">
        <h3 class="mt-3 font-['David_Libre',Helvetica] text-sm font-bold leading-5 sm:text-base lg:mt-4 lg:text-xl lg:leading-6">
          Natalia Lazzo<br>BLACKITTY
        </h3>
        <a href="#blackitty" class="mt-2 inline-block rounded-lg bg-[#101a24] px-8 py-2.5 font-['David_Libre',Helvetica] text-base font-medium text-white hover:opacity-85 transition-opacity">
          Ver Perfil
        </a>
      </article>
    </div>
  </section>

  <!-- Featured Artist: Pistacho Tattoo -->
  <section id="pistacho-tattoo" class="relative overflow-hidden bg-[#f3f3f3] px-4 py-10 sm:px-6 lg:px-0 lg:py-16" aria-labelledby="featured-artist-title">
    <img
      class="pointer-events-none absolute right-0 top-0 hidden h-full w-auto object-cover opacity-5 lg:block"
      src="/images/assets/tattoo-background.png"
      alt=""
    >
    <div class="mx-auto max-w-[1308px] lg:flex lg:flex-wrap lg:px-[63px] lg:py-[46px]">
      <div class="lg:flex lg:w-full lg:items-start lg:justify-between">
        <h2 id="featured-artist-title" class="font-['David_Libre',Helvetica] text-2xl font-bold leading-none sm:text-3xl lg:max-w-[848px] lg:text-[70px] lg:leading-[72px]">
          NUESTRO NUEVO ARTISTA DEL NEW SCHOOL
        </h2>
        <img
          class="mx-auto mt-6 w-full max-w-[280px] object-cover lg:mt-0 lg:max-w-[444px] lg:h-[445px]"
          src="/images/assets/Profe Tattoo.png"
          alt="Pistacho Tattoo"
        >
      </div>
      <p class="mt-6 text-justify font-['Inter',Helvetica] text-sm leading-6 text-[#5c6674] sm:text-base sm:leading-[29px] lg:mt-10 lg:max-w-[750px]">
        PISTACHO TATTOO es un talentoso tatuador especializado en el estilo neotradicional, una corriente artística que fusiona la fuerza y la esencia del tatuaje tradicional con elementos modernos y un enfoque más ilustrativo. Su trabajo se caracteriza por líneas definidas, colores vibrantes y composiciones dinámicas que dan vida a piezas llenas de personalidad y significado.<br><br>
        A lo largo de su trayectoria, Pistacho Tattoo ha explorado una amplia variedad de temáticas, desde animales y elementos florales hasta personajes fantásticos y diseños personalizados, manteniendo siempre la identidad visual propia del estilo neotradicional. Su objetivo no es solo crear tatuajes estéticamente impactantes, sino también plasmar historias, emociones e ideas en cada obra.<br><br>
        Comprometido con la calidad y la satisfacción de sus clientes, dedica tiempo a comprender la visión de cada persona para desarrollar diseños únicos y adaptados a sus preferencias. Actualmente forma parte del equipo de Planet Melmac, donde continúa perfeccionando su técnica, colaborando con otros artistas y evolucionando constantemente dentro del mundo del tatuaje.
      </p>
    </div>
  </section>

  <!-- Blog / News Section - reusing NewsSec component -->
  <NewsSec />
</main>

<Footer />
</body>
</html>
