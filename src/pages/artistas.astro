---
import Layout from "../layouts/Layout.astro";
import NewsPills from "../components/NewsPills";

const artists = [
  {
    name: "Fabian Morales",
    tag: "PROFE TATTOO",
    slug: "profe-tattoo",
    img: "/images/assets/Profe Tattoo-BW.png",
    stagger: ""
  },
  {
    name: "Ignacio Orihuela",
    tag: "PISTACHO TTOO",
    slug: "pistacho-tattoo",
    img: "/images/assets/Pistacho.jpg",
    stagger: "lg:mt-12"
  },
  {
    name: "Juan Maria Savedra",
    tag: "JUANMA",
    slug: "juanma",
    img: "/images/assets/Juanma.jpg",
    stagger: ""
  },
  {
    name: "Juan Caballero",
    tag: "DON JUAN",
    slug: "don-juan",
    img: "/images/assets/Don Juan Caballero-BW.png",
    stagger: "lg:mt-16"
  },
  {
    name: "Natalia Lazzo",
    tag: "BLACKITTY",
    slug: "black-kitty",
    img: "/images/assets/Black Kitty-BW.png",
    stagger: ""
  }
];
---

<Layout title="Artistas" currentPage="artistas">
  <!-- Hero Section Banner -->
  <section class="mx-auto w-full max-w-[1308px] px-4 py-6 sm:px-6 lg:px-8 lg:py-10">
    <div class="relative overflow-hidden bg-white border border-black/10 border-t-0 px-8 py-12 text-black shadow-[0px_4px_20px_rgba(0,0,0,0.08)] sm:px-14 sm:py-16 lg:px-20 lg:py-16 flex flex-col lg:flex-row items-center justify-between gap-12">
      <div class="w-full max-w-[400px] shrink-0 flex justify-center">
        <img src="/images/assets/spider-hero.png" alt="Spider illustration" class="w-full max-w-[340px] h-auto object-contain" />
      </div>
      <div class="max-w-[650px] text-left">
        <h1 class="font-['David_Libre',Helvetica] text-3xl font-bold leading-tight sm:text-4xl lg:text-[44px] lg:leading-[52px] text-black tracking-wide">
          EN NUESTRA COMUNIDAD ESTÁN LOS MEJORES TATUADORES DE COCHABAMBA
        </h1>
        <p class="mt-6 font-['Inter',Helvetica] text-sm leading-relaxed text-[#5c6674] sm:text-base sm:leading-[28px]">
          ¡Bienvenido a nuestra comunidad de tatuadores! Este es un espacio diseñado para compartir conocimientos, exhibir talento y fomentar la colaboración entre artistas. Conecta con profesionales del tatuaje, descubre nuevas oportunidades y forma parte de una red creativa comprometida con el crecimiento y la excelencia artística.
        </p>
      </div>
    </div>
  </section>

  <!-- Nuestros Artistas Section -->
  <section class="relative mx-auto w-full max-w-[1308px] px-4 py-12 sm:px-6 lg:px-8 lg:py-16 text-center">
    <!-- Branch watermark on left -->
    <img class="pointer-events-none absolute left-0 top-1/3 hidden w-48 opacity-30 lg:block" src="/images/assets/branch.png" alt="" />

    <h2 class="font-['David_Libre',Helvetica] text-4xl font-bold text-black sm:text-5xl lg:text-[68px]">
      Nuestros Artistas
    </h2>
    <p class="mx-auto mt-4 max-w-xl font-['Inter',Helvetica] text-sm text-[#5c6674] sm:text-base">
      Conoce a los artistas que forman parte de nuestra comunidad. Explora sus perfiles, descubre su experiencia y encuentra al tatuador que mejor se adapte a tu estilo.
    </p>

    <!-- 5 Artists Staggered Grid -->
    <div class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-5 items-start">
      {artists.map((a) => (
        <article class={`flex flex-col items-center text-center ${a.stagger}`}>
          <div class="relative h-44 w-44 overflow-hidden rounded-full border-4 border-black/10 shadow-lg">
            <img src={a.img} alt={a.name} class="h-full w-full object-cover grayscale" />
          </div>
          <h3 class="mt-5 font-['David_Libre',Helvetica] text-xl font-bold text-black">
            {a.name}
          </h3>
          <p class="font-['Inter',Helvetica] text-xs font-bold tracking-wider text-[#5c6674] uppercase mt-1">
            {a.tag}
          </p>
          <a href={`/artistas/${a.slug}`} class="mt-4 inline-block rounded-full bg-[#101a24] px-6 py-2 font-['Inter',Helvetica] text-xs font-bold text-white hover:bg-black transition-colors shadow-md">
            Ver Perfil
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- NUESTRO NUEVO ARTISTA DEL NEW SCHOOL Section -->
  <section class="w-full py-12 lg:py-16">
    <div class="relative overflow-hidden bg-[#e9e9e9] h-180 py-12 text-black shadow-sm sm:px-14 sm:py-16 lg:px-20 lg:py-16 flex flex-col lg:flex-row items-center justify-between gap-12 border border-black/5">
      <div class="ml-40 max-w-4xl">
        <h2 class="font-['David_Libre',Helvetica] text-6xl font-bold lg:leading-[56px] text-black">
          NUESTRO NUEVO ARTISTA DEL NEW SCHOOL
        </h2>
        <p class="mt-6 font-['Inter',Helvetica] text-lg leading-relaxed text-[#5c6674] sm:leading-[28px]">
          PISTACHO TATTOO es un talentoso tatuador especializado en el estilo neotradicional, una corriente artística que fusiona la fuerza y la esencia del tatuaje tradicional con elementos modernos y un enfoque más ilustrativo. Su trabajo se caracteriza por líneas definidas, colores vibrantes y composiciones dinámicas que dan vida a piezas llenas de personalidad y significado.
        </p>
        <p class="mt-4 font-['Inter',Helvetica] text-lg leading-relaxed text-[#5c6674] sm:leading-[28px]">
          Comprometido con la calidad y la satisfacción de sus clientes, dedica tiempo a comprender la visión de cada persona para desarrollar diseños únicos y adaptados a sus preferencias.
        </p>
      </div>

      <div class="relative w-full max-w-[440px] -mt-48 right-30">
        <div class="overflow-hidden rounded-[6rem] shadow-2xl shadow-black/60">
          <img src="/images/assets/Pistacho.jpg" alt="Ignacio Orihuela - Pistacho Tattoo" class="w-full h-113 object-cover" />
        </div>
        <!-- Floral decoration watermark bottom right -->
        <img class="pointer-events-none absolute -bottom-52 -right-35 w-80 opacity-80" src="/images/figma/svg/Clip_path_group__2003_872.svg" alt="" />
      </div>
    </div>
  </section>

  <!-- Bottom Split Section: Artista destacado & Noticias -->
  <section class="relative mx-auto w-full max-w-[1308px] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Left Column: Artista destacado -->
      <div class="flex flex-col items-center text-center">
        <!-- Floral watermark behind -->
        <img class="pointer-events-none absolute -left-95 top-3/4 -translate-y-1/2 w-74 opacity-80" src="/images/assets/flower.png" alt="" />
        <img class="pointer-events-none absolute -right-95 top-11/12 -translate-y-1/2 w-74 opacity-80" src="/images/assets/flower.png" alt="" />

        <h2 class="font-['David_Libre',Helvetica] text-4xl sm:text-4xl lg:text-[46px] font-bold text-black mb-6">
          Artista destacado
        </h2>

        <div class="overflow-hidden rounded-[4rem] shadow-xl w-full max-w-[340px] h-[340px] mb-6">
          <img src="/images/assets/Don Juan Caballero.jpg" alt="Don Juan Caballero" class="w-full h-full object-cover" />
        </div>

        <p class="max-w-[520px] font-['Inter',Helvetica] text-base text-black leading-relaxed mb-6">
          Don juan Caballero un sus trabajos destacan por colores intensos, contornos definidos y detalles expresivos. Cada diseño busca reflejar personalidad y estilo, convirtiendo la piel en un lienzo vivo.
        </p>

        <a href="/artistas/don-juan" class="inline-block rounded-tl-xl rounded-tr-sm rounded-br-xl rounded-bl-sm bg-[#101a24] px-8 py-3 font-['Inter',Helvetica] text-sm font-bold text-white hover:bg-black transition-colors shadow-lg">
          Ver Perfil
        </a>
      </div>

      <!-- Right Column: Noticias -->
      <div class="flex flex-col items-center text-center">
        <h2 class="font-['David_Libre',Helvetica] text-4xl font-bold text-black">
          Noticias
        </h2>
        <p class="mt-4 max-w-[480px] font-['Inter',Helvetica] text-sm sm:text-base text-[#5c6674] leading-relaxed">
          La Expo Tattoo de Oruro reunió a los mejores artistas del país, mostrando trabajos impresionantes en estilos que van desde el neotradicional hasta el realismo. El evento destacó por la creatividad, técnica y profesionalismo de cada tatuador.
        </p>

        <div class="w-full mt-6">
          <NewsPills client:load />
        </div>
      </div>
    </div>
  </section>
</Layout>
