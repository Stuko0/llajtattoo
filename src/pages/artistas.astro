---
import Layout from "../layouts/Layout.astro";
const artists = [
  { n: "Fabian Morales",     a: "PROFE TATTOO",       img: "/images/assets/Profe Tattoo.png" },
  { n: "Don Juan Caballero", a: "Don Juan Caballero", img: "/images/assets/Don Juan Caballero.png" },
  { n: "Natalia Lazzo",      a: "BLACKITTY",          img: "/images/assets/Black Kitty.png" },
  { n: "Fabian Morales",     a: "PROFE TATTOO",       img: "/images/assets/Profe Tattoo.png" },
  { n: "Don Juan Caballero", a: "Don Juan Caballero", img: "/images/assets/Don Juan Caballero.png" },
  { n: "Natalia Lazzo",      a: "BLACKITTY",          img: "/images/assets/Black Kitty.png" },
];
---
<Layout title="Artistas" currentPage="artistas">
  <section class="bg-black text-white text-center py-16 md:py-20">
    <div class="wrap">
      <h1 class="font-[var(--font-dl)] font-bold text-5xl md:text-6xl lg:text-[70px] leading-none mb-4 text-white">ARTISTAS</h1>
      <p class="font-[var(--font-int)] text-[20px] font-normal text-[var(--color-cg)] max-w-2xl mx-auto">Conoce a los mejores tatuadores de Cochabamba.</p>
    </div>
  </section>

  <section class="bg-white py-16 md:py-24">
    <div class="wrap">
      <div class="flex flex-wrap gap-4 mb-12 max-w-3xl">
        <div class="relative flex-1 min-w-[250px]">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-[var(--cg)] pointer-events-none" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
          <input type="text" placeholder="Buscar artista..." class="w-full py-3.5 pl-12 pr-4 border border-[var(--cgb)] font-[var(--font-int)] text-[15px] outline-none bg-white rounded-lg focus:border-[var(--ca)] transition-colors" />
        </div>
        <select class="py-3.5 px-4 border border-[var(--cgb)] font-[var(--font-int)] text-[15px] min-w-[180px] bg-white cursor-pointer rounded-lg outline-none focus:border-[var(--ca)] transition-colors">
          <option>Todos los estilos</option>
          <option>Fineline</option>
          <option>Tradicional</option>
          <option>Blackwork</option>
          <option>Realismo</option>
        </select>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {artists.map((art, i) => (
          <article
            class="bg-white p-8 flex flex-col items-center text-center shadow-[0_4px_10px_rgba(0,0,0,0.08)] card-hover rounded-xl fu"
            style={`animation-delay: ${i * 80}ms;`}
          >
            <img src={art.img} alt={art.n} class="w-40 h-40 rounded-full object-cover mb-6" width="160" height="160" />
            <h3 class="font-[var(--font-dl)] font-bold text-[20px] mb-1.5 text-black">{art.n}</h3>
            <p class="font-[var(--font-int)] font-bold text-[14px] text-[var(--cm)] uppercase tracking-widest mb-6">{art.a}</p>
            <a href="#" class="btn-vp rounded mt-auto">Ver Perfil</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>