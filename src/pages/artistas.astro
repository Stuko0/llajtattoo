---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Comunidad de tatuadores de Cochabamba, Bolivia. Conoce a los mejores artistas del tattoo en nuestra plataforma.">
<title>Llajtattoo | Artistas</title>
<link rel="stylesheet" href="/globals.css">
<link rel="stylesheet" href="/styleguide.css">
<script is:inline src="https://cdn.tailwindcss.com"></script>
<script is:inline>
tailwind.config = {
      corePlugins: { preflight: false },
      theme: {
        extend: {
          boxShadow: {
            "m3-elevation-light-5": "var(--m3-elevation-light-5)"
          }
        }
      },
      plugins: []
    };
  </script>
</head>
<body class="m-0 bg-white text-black">
<Navbar currentPage="artistas" />

<main>
  <!-- Sección Hero - glass-morphism como en Figma -->
  <section id="inicio" class="mx-auto w-full max-w-[1308px] px-4 pb-8 pt-4 sm:px-6 lg:px-0 lg:pb-16 lg:pt-[60px]" aria-labelledby="community-title">
    <div class="grid overflow-hidden border border-transparent bg-[#ffffff1f] shadow-[0px_4px_4px_#00000040] lg:grid-cols-2 lg:grid-rows-2 lg:gap-x-9 lg:gap-y-[19px] lg:py-0 lg:pl-3.5 lg:pr-[53px]">
      <img
        class="h-full w-full object-cover min-h-[260px] lg:min-h-[512px] lg:row-span-2 lg:w-auto"
        src="/images/hero.png"
        alt="Ilustración decorativa de tatuaje"
      >
      <div class="flex items-end justify-end px-5 pt-6 lg:px-0 lg:pt-0 lg:self-end lg:justify-self-end">
        <h1 id="community-title" class="max-w-[775px] font-['David_Libre',Helvetica] text-2xl font-bold leading-[1.1] sm:text-4xl lg:text-5xl lg:leading-[61px] lg:text-right">
          EN NUESTRA COMUNIDAD ESTÁN LOS MEJORES TATUADORES DE COCHABAMBA
        </h1>
      </div>
      <p class="px-5 pb-6 text-justify font-['Inter',Helvetica] text-[10px] font-normal leading-4 text-[#000000b2] sm:text-sm sm:leading-6 lg:flex lg:items-center lg:px-0 lg:pb-0 lg:text-right lg:text-base lg:leading-[29px]">
        ¡Bienvenido a nuestra comunidad de tatuadores! Este es un espacio diseñado para compartir conocimientos, exhibir talento y fomentar la colaboración entre artistas. Conecta con profesionales del tatuaje, descubre nuevas oportunidades y forma parte de una red creativa comprometida con el crecimiento y la excelencia artística.
      </p>
    </div>
  </section>

  <!-- Sección Nuestros Artistas - con Don Juan staggered -->
  <section id="artistas" class="relative mx-auto w-full overflow-hidden px-4 py-8 text-center sm:px-6 lg:px-0 lg:py-16" aria-labelledby="artists-title">
    <!-- Background decorative image -->
    <img
      class="pointer-events-none absolute bottom-0 left-0 hidden w-28 object-contain opacity-40 lg:block"
      src="/images/assets/dragon-in-black.png"
      alt=""
    >

    <h2 id="artists-title" class="font-['David_Libre',Helvetica] text-2xl font-bold leading-none sm:text-3xl lg:text-[70px] lg:leading-[72px]">
      Nuestros Artistas
    </h2>
    <p class="mx-auto mt-3 max-w-[525px] font-['Inter',Helvetica] text-[10px] font-normal leading-4 sm:text-sm sm:leading-6 lg:mt-6 lg:text-base lg:leading-[29px]">
      Conoce a los artistas que forman parte de nuestra comunidad. Explora sus perfiles, descubre su experiencia y encuentra al tatuador que mejor se adapte a tu estilo.
    </p>

    <!-- Artist grid - 5 columnas como Figma, Don Juan más abajo -->
    <div class="relative mx-auto mt-8 max-w-[1111px] lg:mt-12 lg:h-[386px]">
      <!-- Fabian Morales -->
      <article class="flex flex-col items-center text-center lg:absolute lg:left-0 lg:top-2 lg:w-[195px]">
        <img class="h-24 w-24 rounded-full object-cover sm:h-28 sm:w-28 lg:h-[156px] lg:w-[156px]" src="/images/assets/Profe Tattoo.png" alt="Fabian Morales, Profe Tattoo">
        <h3 class="mt-3 font-['David_Libre',Helvetica] text-sm font-bold leading-5 sm:text-base lg:mt-4 lg:text-xl lg:leading-6">
          Fabian Morales<br>PROFE TATTOO
        </h3>
        <a href="#fabian-morales" class="relative mt-2 inline-block h-[42px] w-[122px]">
          <svg class="absolute -left-[30px] -top-[15px] h-[102px] w-[180px]" viewBox="0 0 180 102" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="30" y="15" width="120" height="42" rx="10" fill="#101a24"/>
          </svg>
          <span class="absolute left-[27px] top-2.5 whitespace-nowrap font-['David_Libre',Helvetica] text-base font-medium leading-normal text-white">Ver Perfil</span>
        </a>
      </article>

      <!-- Ignacio Orihuela -->
      <article class="mt-6 flex flex-col items-center text-center lg:absolute lg:left-[236px] lg:top-0 lg:mt-0 lg:w-[195px]">
        <img class="h-24 w-24 rounded-full object-cover sm:h-28 sm:w-28 lg:h-[156px] lg:w-[156px]" src="/images/assets/Profe Tattoo.png" alt="Ignacio Orihuela, Pistacho Tattoo">
        <h3 class="mt-3 font-['David_Libre',Helvetica] text-sm font-bold leading-5 sm:text-base lg:mt-4 lg:text-xl lg:leading-6">
          Ignacio Orihuela<br>PISTACHO TTOO
        </h3>
        <a href="#pistacho-tattoo" class="relative mt-2 inline-block h-[42px] w-[122px]">
          <svg class="absolute -left-[30px] -top-[15px] h-[102px] w-[180px]" viewBox="0 0 180 102" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="30" y="15" width="120" height="42" rx="10" fill="#101a24"/>
          </svg>
          <span class="absolute left-[27px] top-2.5 whitespace-nowrap font-['David_Libre',Helvetica] text-base font-medium leading-normal text-white">Ver Perfil</span>
        </a>
      </article>

      <!-- Juan Maria Savedra -->
      <article class="mt-6 flex flex-col items-center text-center lg:absolute lg:left-[456px] lg:top-0 lg:mt-0 lg:w-[195px]">
        <img class="h-24 w-24 rounded-full object-cover sm:h-28 sm:w-28 lg:h-[156px] lg:w-[156px]" src="/images/assets/Don Juan Caballero.png" alt="Juan Maria Savedra, Juanma">
        <h3 class="mt-3 font-['David_Libre',Helvetica] text-sm font-bold leading-5 sm:text-base lg:mt-4 lg:text-xl lg:leading-6">
          Juan Maria Savedra<br>JUANMA
        </h3>
        <a href="#juanma" class="relative mt-2 inline-block h-[42px] w-[122px]">
          <svg class="absolute -left-[30px] -top-[15px] h-[102px] w-[180px]" viewBox="0 0 180 102" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="30" y="15" width="120" height="42" rx="10" fill="#101a24"/>
          </svg>
          <span class="absolute left-[27px] top-2.5 whitespace-nowrap font-['David_Libre',Helvetica] text-base font-medium leading-normal text-white">Ver Perfil</span>
        </a>
      </article>

      <!-- Juan Caballero - STAGGERED (más abajo en Figma) -->
      <article class="mt-6 flex flex-col items-center text-center lg:absolute lg:left-[705px] lg:top-[110px] lg:mt-0 lg:w-[195px]">
        <img class="h-24 w-24 rounded-full object-cover sm:h-28 sm:w-28 lg:h-[156px] lg:w-[156px]" src="/images/assets/Don Juan Caballero.png" alt="Juan Caballero, Don Juan">
        <h3 class="mt-3 font-['David_Libre',Helvetica] text-sm font-bold leading-5 sm:text-base lg:mt-4 lg:text-xl lg:leading-6">
          Juan Caballero<br>DON JUAN
        </h3>
        <a href="#don-juan" class="relative mt-2 inline-block h-[42px] w-[122px]">
          <svg class="absolute -left-[30px] -top-[15px] h-[102px] w-[180px]" viewBox="0 0 180 102" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="30" y="15" width="120" height="42" rx="10" fill="#101a24"/>
          </svg>
          <span class="absolute left-[27px] top-2.5 whitespace-nowrap font-['David_Libre',Helvetica] text-base font-medium leading-normal text-white">Ver Perfil</span>
        </a>
      </article>

      <!-- Natalia Lazzo -->
      <article class="mt-6 flex flex-col items-center text-center lg:absolute lg:left-[916px] lg:top-0 lg:mt-0 lg:w-[195px]">
        <img class="h-24 w-24 rounded-full object-cover sm:h-28 sm:w-28 lg:h-[156px] lg:w-[156px]" src="/images/assets/Black Kitty.png" alt="Natalia Lazzo, Blackitty">
        <h3 class="mt-3 font-['David_Libre',Helvetica] text-sm font-bold leading-5 sm:text-base lg:mt-4 lg:text-xl lg:leading-6">
          Natalia Lazzo<br>BLACKITTY
        </h3>
        <a href="#blackitty" class="relative mt-2 inline-block h-[42px] w-[122px]">
          <svg class="absolute -left-[30px] -top-[15px] h-[102px] w-[180px]" viewBox="0 0 180 102" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="30" y="15" width="120" height="42" rx="10" fill="#101a24"/>
          </svg>
          <span class="absolute left-[27px] top-2.5 whitespace-nowrap font-['David_Libre',Helvetica] text-base font-medium leading-normal text-white">Ver Perfil</span>
        </a>
      </article>
    </div>

    <!-- Decorative element -->
    <img
      class="pointer-events-none absolute bottom-0 right-0 hidden w-28 object-contain opacity-30 lg:block"
      src="/images/assets/flowers-in-black.png"
      alt=""
    >
  </section>

  <!-- Sección Artista Destacado: Pistacho Tattoo -->
  <section id="pistacho-tattoo" class="relative overflow-hidden bg-[#f3f3f3] px-4 py-10 sm:px-6 lg:px-0 lg:py-16" aria-labelledby="featured-artist-title">
    <img
      class="pointer-events-none absolute right-0 top-0 hidden h-full w-auto object-cover opacity-5 lg:block"
      src="/images/assets/tattoo-background.png"
      alt=""
    >
    <div class="mx-auto grid max-w-[1308px] gap-6 lg:grid-cols-2 lg:grid-rows-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-2.5 lg:px-[63px] lg:py-[46px]">
      <h2 id="featured-artist-title" class="font-['David_Libre',Helvetica] text-2xl font-bold leading-none sm:text-3xl lg:self-center lg:text-[70px] lg:leading-[72px] lg:row-start-1 lg:w-[848px]">
        NUESTRO NUEVO ARTISTA DEL NEW SCHOOL
      </h2>
      <img
        class="mx-auto w-full max-w-[320px] object-cover lg:row-start-1 lg:justify-self-end lg:max-w-[444px] lg:h-[445px]"
        src="/images/assets/Profe Tattoo.png"
        alt="Pistacho Tattoo"
      >
      <p class="text-justify font-['Inter',Helvetica] text-sm leading-6 text-[#5c6674] sm:text-base sm:leading-[29px] lg:row-start-2 lg:self-center lg:max-w-[750px]">
        PISTACHO TATTOO es un talentoso tatuador especializado en el estilo neotradicional, una corriente artística que fusiona la fuerza y la esencia del tatuaje tradicional con elementos modernos y un enfoque más ilustrativo. Su trabajo se caracteriza por líneas definidas, colores vibrantes y composiciones dinámicas que dan vida a piezas llenas de personalidad y significado.<br><br>
        A lo largo de su trayectoria, Pistacho Tattoo ha explorado una amplia variedad de temáticas, desde animales y elementos florales hasta personajes fantásticos y diseños personalizados, manteniendo siempre la identidad visual propia del estilo neotradicional. Su objetivo no es solo crear tatuajes estéticamente impactantes, sino también plasmar historias, emociones e ideas en cada obra.<br><br>
        Comprometido con la calidad y la satisfacción de sus clientes, dedica tiempo a comprender la visión de cada persona para desarrollar diseños únicos y adaptados a sus preferencias. Actualmente forma parte del equipo de Planet Melmac, donde continúa perfeccionando su técnica, colaborando con otros artistas y evolucionando constantemente dentro del mundo del tatuaje.
      </p>
    </div>
  </section>

  <!-- Sección Blog/Noticias - con Artista destacado + Noticias como en Figma -->
  <section id="blog" class="relative overflow-hidden px-4 py-10 sm:px-6 lg:py-16" aria-labelledby="news-title">
    <!-- Decorative background images from Figma -->
    <img
      class="pointer-events-none absolute left-0 top-[148px] hidden h-[348px] w-[177px] object-cover opacity-20 lg:block"
      src="/images/assets/branch.png"
      alt=""
    >
    <img
      class="pointer-events-none absolute right-0 top-[392px] hidden h-[348px] w-[185px] object-cover opacity-20 lg:block"
      src="/images/assets/flowers-in-black.png"
      alt=""
    >

    <div class="mx-auto max-w-[1308px] lg:grid lg:grid-cols-[492px_1fr] lg:gap-8">
      <!-- Left: Artista destacado (Don Juan) -->
      <article id="don-juan" class="text-center" aria-labelledby="featured-title">
        <h2 id="featured-title" class="font-['David_Libre',Helvetica] text-3xl font-bold leading-none sm:text-4xl lg:text-5xl lg:leading-[72px]">
          Artista destacado
        </h2>
        <img
          class="mx-auto mt-4 h-32 w-32 rounded-full object-cover sm:h-40 sm:w-40 lg:mt-[19px] lg:h-[255px] lg:w-[255px]"
          src="/images/assets/Don Juan Caballero.png"
          alt="Don Juan Caballero trabajando"
        >
        <p class="mx-auto mt-4 max-w-[360px] font-['Inter',Helvetica] text-sm leading-6 sm:text-base sm:leading-[29px] lg:mt-5 lg:w-[460px]">
          Don Juan Caballero en sus trabajos destacan por colores intensos, contornos definidos y detalles expresivos. Cada diseño busca reflejar personalidad y estilo, convirtiendo la piel en un lienzo vivo.
        </p>
        <a href="#don-juan" class="relative mx-auto mt-4 inline-block h-[42px] w-[122px] lg:mt-[11px]">
          <svg class="absolute -left-[30px] -top-[15px] h-[102px] w-[180px]" viewBox="0 0 180 102" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="30" y="15" width="120" height="42" rx="10" fill="#101a24"/>
          </svg>
          <span class="absolute left-[27px] top-2.5 whitespace-nowrap font-['David_Libre',Helvetica] text-base font-medium leading-normal text-white">Ver Perfil</span>
        </a>
      </article>

      <!-- Right: Noticias con imágenes superpuestas -->
      <article class="relative mt-10 text-center lg:mt-0 lg:h-[719px]" aria-labelledby="news-title-2">
        <h2 id="news-title-2" class="font-['David_Libre',Helvetica] text-3xl font-bold leading-none sm:text-4xl lg:text-5xl lg:leading-[72px] lg:text-center">
          Noticias
        </h2>
        <p class="mx-auto mt-3 max-w-[525px] text-justify font-['Inter',Helvetica] text-sm leading-6 sm:text-base sm:leading-[29px] lg:mt-[63px] lg:mx-[75px]">
          La Expo Tattoo de Oruro reunió a los mejores artistas del país, mostrando trabajos impresionantes en estilos que van desde el neotradicional hasta el realismo. El evento destacó por la creatividad, técnica y profesionalismo de cada tatuador. Visitantes disfrutaron de demostraciones en vivo y diseños únicos que dejaron huella.
        </p>

        <!-- Mobile: simple single image -->
        <img
          class="mx-auto mt-6 h-48 w-full max-w-[300px] rounded-xl object-cover shadow-md lg:hidden"
          src="/images/assets/new1.png"
          alt="Noticias de tatuajes"
        >
        <!-- Desktop: overlapping images como en Figma -->
        <div class="relative mx-auto mt-6 hidden h-[300px] w-full max-w-[540px] lg:mt-0 lg:absolute lg:top-[234px] lg:left-[235px] lg:block lg:h-[359px] lg:w-[542px]">
          <img
            class="absolute right-0 top-0 h-[359px] w-[331px] object-cover"
            src="/images/assets/new1.png"
            alt="Tatuaje artístico"
          >
          <img
            class="absolute right-[40px] top-0 h-[359px] w-[374px] object-cover"
            src="/images/assets/new2.png"
            alt="Diseño de tatuaje"
          >
          <img
            class="absolute left-0 top-0 h-[357px] w-full object-cover"
            src="/images/assets/new3.png"
            alt="Galería de tatuajes"
          >
          <img
            class="absolute left-[112px] top-0 h-[359px] w-[420px] object-cover"
            src="/images/assets/new4.png"
            alt="Tatuaje en detalle"
          >
        </div>
      </article>
    </div>

    <!-- Decorative element -->
    <img
      class="pointer-events-none absolute bottom-0 right-0 hidden w-32 object-contain opacity-30 lg:block"
      src="/images/assets/flower.png"
      alt=""
    >
  </section>
</main>

<Footer />
</body>
</html>
