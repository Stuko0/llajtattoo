---
import Layout from "../../layouts/Layout.astro";
import SpecialtyExpand from "../../components/SpecialtyExpand.tsx";

export function getStaticPaths() {
  return [
    { params: { slug: "black-kitty" } },
    { params: { slug: "natalia-lazzo" } },
    { params: { slug: "don-juan" } },
    { params: { slug: "juan-caballero" } },
    { params: { slug: "juanma" } },
    { params: { slug: "juan-maria-savedra" } },
    { params: { slug: "pistacho-tattoo" } },
    { params: { slug: "ignacio-orihuela" } },
    { params: { slug: "profe-tattoo" } },
    { params: { slug: "fabian-morales" } }
  ];
}

const { slug } = Astro.params;

const artistsData: Record<string, any> = {
  "black-kitty": {
    slug: "black-kitty",
    name: "Natalia Lazzo",
    alias: "BLACKITTY",
    avatar: "/images/assets/blackkitty-profile.png",
    themeColor: "#f72b8e",
    bio: "Nati, conocida artísticamente como Blackitty, tiene 24 años y 2 años de experiencia en el mundo del tatuaje. Especializada en los estilos Blackwork y Fine Line, se caracteriza por crear diseños personalizados que combinan precisión, elegancia y significado. Actualmente dirige un estudio privado exclusivo para mujeres, un espacio seguro y acogedor donde continúa perfeccionando su técnica y transformando ideas en obras de arte sobre la piel.",
    specialties: ["Blackwork", "Puntillismo", "Fine Line", "Tradicional"],
    socials: {
      tiktok: "https://tiktok.com/@blackitty",
      whatsapp: "https://wa.me/59100000000",
      instagram: "https://instagram.com/blackitty"
    },
    variant: "black-kitty"
  },
  "don-juan": {
    slug: "don-juan",
    name: "Juan Caballero",
    alias: "DON JUAN CABALLERO",
    avatar: "/images/assets/Don Juan Caballero.jpg",
    themeColor: "#f6b100",
    bio: "Un artista con 8 años de trayectoria en el mundo del tatuaje, este artista se ha especializado en el estilo neotradicional, destacándose por su interés en la iconografía de las máscaras Hannya. Su trabajo se caracteriza por el uso de colores vibrantes, líneas sólidas y composiciones expresivas que combinan elementos tradicionales con una visión contemporánea. Desde Planet Melmac, continúa perfeccionando su propuesta artística y creando piezas únicas llenas de personalidad y significado.",
    specialties: ["Neo tradicional", "Linea Fina", "Tradicional"],
    socials: {
      tiktok: "https://tiktok.com/@donjuan",
      instagram: "https://instagram.com/donjuan",
      whatsapp: "https://wa.me/59100000000"
    },
    variant: "don-juan"
  },
  "juanma": {
    slug: "juanma",
    name: "Juan Maria Savedra",
    alias: "Juanma",
    avatar: "/images/assets/Juanma.jpg",
    themeColor: "#ffffff",
    bio: "Juan María, conocido artísticamente como Juanma, tiene 25 años y cuenta con más de 3 años de experiencia en el mundo del tatuaje. Su especialidad son los tatuajes de estilo botánico, caracterizados por su delicadeza y atención al detalle. Actualmente desarrolla su trabajo en Cochabamba y Sucre, donde continúa perfeccionando su técnica y creando piezas únicas que reflejan la esencia de cada cliente.",
    specialties: ["Botánico", "Puntillismo", "Blackwork"],
    socials: {
      tiktok: "https://tiktok.com/@juanma",
      instagram: "https://instagram.com/juanma",
      whatsapp: "https://wa.me/59100000000"
    },
    variant: "juanma"
  },
  "pistacho-tattoo": {
    slug: "pistacho-tattoo",
    name: "Ignacio Orihuela",
    alias: "PISTACHO TATTOO",
    avatar: "/images/assets/Pistacho.jpg",
    themeColor: "#00fd3b",
    bio: "Ignacio, conocido artísticamente como Pistacho, tiene 24 años y más de 3 años de experiencia en el mundo del tatuaje. Especializado en el estilo neotradicional, se caracteriza por crear piezas llenas de personalidad, utilizando líneas sólidas, colores intensos y composiciones dinámicas. Actualmente forma parte del equipo de Planet Melmac, donde sigue perfeccionando su técnica y transformando las ideas de sus clientes en diseños únicos y memorables.",
    specialties: ["Fine Line", "Tradicional", "Neotradicional", "Blackwork"],
    socials: {
      tiktok: "https://tiktok.com/@pistachotattoo",
      instagram: "https://instagram.com/pistachotattoo",
      whatsapp: "https://wa.me/59100000000"
    },
    variant: "pistacho-tattoo"
  },
  "profe-tattoo": {
    slug: "profe-tattoo",
    name: "Fabian Morales",
    alias: "Profe Tattoo",
    avatar: "/images/assets/Profe Tattoo.jpg",
    themeColor: "#101a24",
    bio: "Fabián, conocido artísticamente como Profe Tattoo, lleva más de 7 años dedicados al arte del tatuaje. Es fundador de TintaLatte, su estudio profesional, donde plasma su experiencia y pasión en cada proyecto. Su extensa trayectoria le ha permitido dominar diversos estilos de tatuaje, convirtiéndose en un artista versátil reconocido por la calidad, precisión y excelencia de su trabajo.",
    specialties: ["Fine Line", "Realismo", "Blackwork", "Patch Tattoo"],
    socials: {
      tiktok: "https://tiktok.com/@profetattoo",
      instagram: "https://instagram.com/profetattoo",
      whatsapp: "https://wa.me/59100000000"
    },
    variant: "profe-tattoo"
  }
};

artistsData["natalia-lazzo"] = artistsData["black-kitty"];
artistsData["juan-caballero"] = artistsData["don-juan"];
artistsData["juan-maria-savedra"] = artistsData["juanma"];
artistsData["ignacio-orihuela"] = artistsData["pistacho-tattoo"];
artistsData["fabian-morales"] = artistsData["profe-tattoo"];

const artist = artistsData[slug as string] || artistsData["black-kitty"];

// Mapa de especialidades → imágenes expandibles (1 o 2 según Figma)
const S = "/images/assets/style-";
const specialtyImages: Record<string, string[]> = {
  "Blackwork": [`${S}blackwork-1.jpg`, `${S}blackwork-2.jpg`],
  "Puntillismo": [`${S}puntillismo-1.jpg`, `${S}puntillismo-2.jpg`],
  "Fine Line": [`${S}fineline.jpg`],
  "Linea Fina": [`${S}fineline.jpg`],
  "Tradicional": [`${S}tradicional-1.jpg`, `${S}tradicional-2.jpg`],
  "Neo tradicional": [`${S}neotradicional-1.jpg`, `${S}neotradicional-2.jpg`],
  "Neotradicional": [`${S}neotradicional-1.jpg`, `${S}neotradicional-2.jpg`],
  "Realismo": [`${S}realismo-1.jpg`, `${S}realismo-2.jpg`],
  "Relaismo": [`${S}realismo-1.jpg`, `${S}realismo-2.jpg`],
  "Patch Tattoo": [`${S}patch-1.jpg`, `${S}patch-2.jpg`],
  "Patch Tatto": [`${S}patch-1.jpg`, `${S}patch-2.jpg`],
  "Botánico": [`${S}botanico-1.jpg`, `${S}botanico-2.jpg`],
  "Botanico": [`${S}botanico-1.jpg`, `${S}botanico-2.jpg`],
};
---

<Layout title={`${artist.name} (${artist.alias}) | Artista`} currentPage="artistas" theme="dark">
  {/* Contenido full-bleed: ocupa todo el ancho/alto disponible (navbar y footer respetados) */}
  <div class="w-full min-h-full">

      {/* =========================================
          VARIANT 1: BLACK KITTY (Pink / Magenta Dark)
         ========================================= */}
      {artist.variant === "black-kitty" && (
        <div class="relative bg-white text-black p-8 sm:p-12 lg:p-16 border border-pink-900/30 overflow-hidden min-h-[640px] flex flex-col justify-between">
          <!-- Background Smokey Graphic -->
          <div class="absolute inset-0 bg-radial from-[#4a0d33]/40 via-transparent to-transparent pointer-events-none"></div>
          <img src="/images/assets/tattoo-background.png" alt="" class="absolute right-0 top-0 w-[550px] opacity-15 mix-blend-screen pointer-events-none filter hue-rotate-[290deg]" />

          <!-- Top Layout Grid -->
          <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-10">
            <!-- Left Info Column (7 cols) -->
            <div class="lg:col-span-7 flex flex-col">
                <div class="items-center">
                  <span class="font-['Blinker',Helvetica] text-xl font-bold tracking-widest text-black uppercase">
                    TU TATUADOR
                  </span>
                  <!-- Metal / Gothic Logo Text -->
                  <img src="/images/assets/blackkitty-banner.png" alt={artist.name} class="w-1/2 h-1/2 object-cover filter contrast-110 invert" />
                  <p class="mt-8 font-['Inter',Helvetica] text-sm sm:text-base leading-relaxed text-black max-w-xl">
                    {artist.bio}
                  </p>
                </div>
              <!-- Horizontal Divider -->
              <div class="relative z-10 my-8 border-t-2 border-[#f72b8e]"></div>
              <!-- Specialties vertically on left -->
              <div class="mt-12 items-start">
                <h3 class="font-['Blinker',Helvetica] text-[40px] font-bold tracking-wide uppercase text-black mb-6 leading-none">
                  ESPECIALIDADES
                </h3>
                <div class="flex flex-col gap-8 max-w-[260px]">
                  {artist.specialties.map((spec: string) => (
                    <SpecialtyExpand
                      client:load
                      label={spec}
                      images={specialtyImages[spec] || []}
                      accent="#f72b8e"
                      pillBg="bg-black/60"
                      pillText="text-black"
                      pillBorder="border border-[#f72b8e]/40"
                      pillRadius="rounded-4xl"
                      fontFamily="font-['David_Libre',Helvetica]"
                      fontWeight="font-medium"
                      expandDir="down"
                    />
                  ))}
                </div>
              </div>
            </div>

            <!-- Right Column (5 cols): Moon Avatar & Booking -->
            <div class="lg:col-span-5 flex flex-col items-center lg:border-l-2 lg:border-[#f72b8e]/60 lg:pl-12">
              <!-- Moon Avatar Frame -->
              <div class="relative w-64 h-64 sm:w-72 sm:h-72 rounded-[40px] overflow-hidden shadow-[0_0_40px_rgba(247,43,142,0.5)]">
                <img src={artist.avatar} alt={artist.name} class="w-full h-full object-cover filter contrast-110" />
                <div class="absolute inset-0 bg-gradient-to-t from-[#f72b8e]/30 to-transparent pointer-events-none"></div>
              </div>

              <!-- Booking Section Below Divider -->
              <div class="mt-14 flex flex-col items-center text-center">
                <h3 class="font-['Blinker',Helvetica] text-[40px] font-semibold tracking-wider text-[#f72b8e] uppercase leading-none">
                  AGENDA UNA CITA YA!
                </h3>
                <div class="text-[#f72b8e] my-3">▼</div>
                <div class="flex flex-col items-center gap-5 mt-4">
                    <a href={artist.socials.tiktok} target="_blank" class="w-24 h-24 rounded-full border-[1.5px] border-[#f72b8e] flex items-center justify-center text-[#f72b8e] hover:bg-[#f72b8e] hover:text-white transition-all transform hover:scale-110 shadow-lg">
                        <svg class="h-14 w-14 fill-current" viewBox="0 0 62 72" xmlns="http://www.w3.org/2000/svg">
                        <path d="M32.9282 0H44.8684C45.2886 4.92264 49.3033 15.2725 62 17.2911V28.8679C58.4896 28.9174 50.1488 27.8438 44.8684 23.1537V52.6153C43.8548 58.849 37.9712 71.45 22.5454 71.9843C7.1195 72.5186 1.13703 59.2943 0.0740294 52.6153C-0.593436 44.1306 2.96638 27.0275 22.5454 26.4932V37.9958C19.1092 38.2679 11.5693 42.3 11.5693 49.6469C11.5693 56.9937 18.4658 59.7058 22.5454 59.6653C26.6249 59.6249 32.9282 57.2906 32.9282 49.6469C32.9282 42.0032 32.5821 13.5063 32.9282 0Z"/>
                        </svg>
                    </a>
                    <a href={artist.socials.instagram} target="_blank" class="w-24 h-24 rounded-full border-[1.5px] border-[#f72b8e] flex items-center justify-center text-[#f72b8e] hover:bg-[#f72b8e] hover:text-white transition-all transform hover:scale-110 shadow-lg">
                        <svg class="h-14 w-14 fill-current" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                        </svg>
                    </a>
                    <a href={artist.socials.whatsapp} target="_blank" class="w-24 h-24 rounded-full border-[1.5px] border-[#f72b8e] flex items-center justify-center text-[#f72b8e] hover:bg-[#f72b8e] hover:text-white transition-all transform hover:scale-110 shadow-lg">
                        <svg class="h-14 w-14 fill-current" viewBox="0 0 24 24">
                        <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                        </svg>
                    </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* =========================================
          VARIANT 2: DON JUAN CABALLERO (Gold & Hannya)
         ========================================= */}
      {artist.variant === "don-juan" && (
        <div class="relative bg-[#141414] text-white p-8 sm:p-12 lg:p-16 overflow-hidden min-h-[640px]">
          <!-- Background Hannya Mask Watermark -->
          <div class="absolute inset-0 flex justify-center items-center opacity-25 pointer-events-none">
            <img src="/images/assets/don juan-bg.jpg" alt="" class="w-full object-fill filter contrast-200 opacity-50" />
          </div>

          <!-- Header -->
          <div class="relative z-10 text-center mb-12">
            <span class="font-['Blinker',Helvetica] text-5xl tracking-widest text-white uppercase">
              TU TATUADOR
            </span>
            <h1 class="mt-2 font-['Frank_Ruhl_Libre',serif] text-6xl font-normal tracking-wider text-[#f6b100] drop-shadow-[0_0_30px_rgba(229,247,194,0.6)] ">
              {artist.alias}
            </h1>
          </div>

          <!-- Content Grid -->
          <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
            <!-- Left Avatar & Bio (6 cols) -->
            <div class="lg:col-span-6 flex flex-col items-center text-center border-r-3 lg:border-[#f6b100]">
              <div class="w-56 h-56 sm:w-64 sm:h-64 rounded-full overflow-hidden shadow-[0_0_30px_rgba(246,177,0,0.3)] mb-6">
                <img src={artist.avatar} alt={artist.name} class="w-full h-full object-cover" />
              </div>
              <p class="font-['Inter',Helvetica] text-sm sm:text-base text-justify leading-relaxed text-white max-w-lg">
                {artist.bio}
              </p>
            </div>

            <!-- Right Specialties & Booking (6 cols) -->
            <div class="lg:col-span-6 flex flex-col items-left">
              <h3 class="font-['Blinker',Helvetica] text-[40px] font-bold tracking-wide uppercase text-white mb-6 leading-none">
                ESPECIALIDADES
              </h3>

              <div class="flex flex-col gap-[120px] w-full max-w-[280px]">
                {artist.specialties.map((spec: string) => (
                  <SpecialtyExpand
                    client:load
                    label={spec}
                    images={specialtyImages[spec] || []}
                    accent="#f6b100"
                    pillBg="bg-black/80"
                    pillText="text-white"
                    pillBorder="border border-[#f6b100]/50"
                    pillRadius="rounded-tl-[6rem] rounded-tr-4xl rounded-br-[6rem] rounded-bl-4xl"
                    fontFamily="font-['David_Libre',Helvetica]"
                    fontWeight="font-bold"
                    expandDir="down"
                  />
                ))}
              </div>
            </div>
          </div>
          <!-- Booking Section -->
          <div class="mt-14 flex flex-col items-center text-center">
            <h3 class="font-['Blinker',Helvetica] text-[40px] font-semibold tracking-wider text-[#f6b100] uppercase leading-none">
              AGENDA UNA CITA YA!
            </h3>
            <div class="flex items-center gap-12 mt-6">
              <a href={artist.socials.tiktok} target="_blank" class="w-24 h-24 rounded-full border-[1.5px] border-[#f6b100] flex items-center justify-center text-[#f6b100] hover:bg-[#f6b100] hover:text-black transition-all transform hover:scale-110 shadow-lg">
                  <svg class="h-14 w-14 fill-current" viewBox="0 0 62 72" xmlns="http://www.w3.org/2000/svg">
                  <path d="M32.9282 0H44.8684C45.2886 4.92264 49.3033 15.2725 62 17.2911V28.8679C58.4896 28.9174 50.1488 27.8438 44.8684 23.1537V52.6153C43.8548 58.849 37.9712 71.45 22.5454 71.9843C7.1195 72.5186 1.13703 59.2943 0.0740294 52.6153C-0.593436 44.1306 2.96638 27.0275 22.5454 26.4932V37.9958C19.1092 38.2679 11.5693 42.3 11.5693 49.6469C11.5693 56.9937 18.4658 59.7058 22.5454 59.6653C26.6249 59.6249 32.9282 57.2906 32.9282 49.6469C32.9282 42.0032 32.5821 13.5063 32.9282 0Z"/>
                  </svg>
              </a>
              <a href={artist.socials.instagram} target="_blank" class="w-24 h-24 rounded-full border-[1.5px] border-[#f6b100] flex items-center justify-center text-[#f6b100] hover:bg-[#f6b100] hover:text-black transition-all transform hover:scale-110 shadow-lg">
                  <svg class="h-14 w-14 fill-current" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
              </a>
              <a href={artist.socials.whatsapp} target="_blank" class="w-24 h-24 rounded-full border-[1.5px] border-[#f6b100] flex items-center justify-center text-[#f6b100] hover:bg-[#f6b100] hover:text-black transition-all transform hover:scale-110 shadow-lg">
                  <svg class="h-14 w-14 fill-current" viewBox="0 0 24 24">
                    <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                  </svg>
              </a>
            </div>
          </div>
        </div>
      )}

      {/* =========================================
          VARIANT 3: JUANMA (Botanical Cursive)
         ========================================= */}
      {artist.variant === "juanma" && (
        <div class="relative bg-[#2d2d2d] text-white p-8 sm:p-12 lg:p-16 overflow-hidden min-h-[640px]">
          <!-- Background Botanical Overlay -->
          <img src="/images/assets/jaunma-bg.png" alt="" class="absolute inset-0 w-full h-full object-cover opacity-20 pointer-events-none mix-blend-screen" />

          <!-- Top Hero Split -->
          <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 ml-[20rem]">
            <!-- Avatar Left (4 cols) -->
            <div class="lg:col-span-4 flex flex-col justify-center items-center">
                <span class="font-['Blinker',Helvetica] text-5xl font-light tracking-widest text-white uppercase pb-5">
                  TU TATUADOR
                </span>
              <div class="w-56 h-56 sm:w-64 sm:h-64 rounded-full overflow-hidden border-4 border-white shadow-2xl">
                <img src={artist.avatar} alt={artist.name} class="w-full h-full object-cover" />
              </div>
            </div>

