---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Únete" currentPage="unete">
  <!-- Hero Section Banner -->
  <section class="mx-auto w-full max-w-[1308px] px-4 py-6 sm:px-6 lg:px-8 lg:py-10">
    <div class="relative overflow-hidden rounded-[30px] bg-black px-8 py-12 text-white shadow-[0px_4px_20px_rgba(0,0,0,0.2)] sm:px-14 sm:py-16 lg:px-20 lg:py-20 flex flex-col lg:flex-row items-center justify-between gap-10">
      <div class="max-w-105 text-center">
        <h1 class="font-['David_Libre',Helvetica] text-4xl font-bold leading-tight sm:text-5xl lg:text-[70px] lg:leading-[75px] text-white">
          ÚNETE
        </h1>
        <p class="mt-6 font-['Inter',Helvetica] text-sm leading-relaxed text-white/90 sm:text-base sm:leading-[28px] lg:text-lg">
          Forma parte de nuestra comunidad de tatuadores y haz crecer tu carrera artística. Comparte tu trabajo, conecta con nuevos clientes, interactúa con otros artistas y disfruta de beneficios exclusivos diseñados para impulsar tu desarrollo dentro del mundo del tatuaje.
        </p>
        <div class="mt-8">
          <a href="https://api.whatsapp.com/send?phone=59176138478&text=Hola,%20quiero%20unirme%20a%20la%20comunidad" target="_blank" rel="noopener noreferrer" class="inline-block rounded-tl-xl rounded-tr-sm rounded-br-xl rounded-bl-sm bg-[#dcdcdc] px-10 py-3.5 font-['Inter',Helvetica] text-base font-bold text-black hover:bg-white transition-all shadow-md hover:-translate-y-0.5">
            Inscribirme
          </a>
        </div>
      </div>
      <div class="relative w-full flex justify-center lg:justify-end">
        <img src="/images/full-dragon.png" alt="Dragón estilo tatuaje" class="w-full h-auto object-contain opacity-90" />
      </div>
    </div>
  </section>

  <!-- Location Section -->
  <section class="relative overflow-hidden bg-[#e9e9e9] py-14 sm:py-20">
    <!-- Decorative side leaves -->
    <img class="pointer-events-none absolute -left-30 top-3/4 -translate-y-1/2 hidden w-90 opacity-80 lg:block" src="/images/figma/svg/Clip_path_group__2003_762.svg" alt="" />
    <img class="pointer-events-none absolute -right-30 top-3/4 -translate-y-1/2 hidden w-100 opacity-80 lg:block" src="/images/figma/svg/Clip_path_group__2003_984.svg" alt="" />

    <div class="mx-auto flex w-full max-w-[1308px] flex-col items-center justify-center gap-10 px-4 sm:px-6 lg:flex-row lg:gap-20 lg:px-8">
      <!-- Map graphic box -->
      <div class="relative overflow-hidden rounded-2xl bg-white p-3 shadow-lg max-w-[520px] w-full border border-black/10">
        <div class="relative h-[280px] w-full overflow-hidden rounded-xl bg-[#e5e3df] flex items-center justify-center">
          <!-- Stylized map representation -->
          <svg class="absolute inset-0 w-full h-full text-black/10" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 40H520M0 120H520M0 200H520M120 0V280M280 0V280M420 0V280" stroke="white" stroke-width="6"/>
            <path d="M60 0L200 280M300 0L480 280" stroke="#f6d5a1" stroke-width="12" opacity="0.6"/>
            <rect x="140" y="80" width="180" height="120" rx="8" fill="#c8e6c9" opacity="0.5"/>
          </svg>
          <!-- Map Pin Marker -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-[#f72b8e] text-white shadow-xl animate-bounce">
              <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
            </div>
            <span class="mt-2 rounded-full bg-white px-3 py-1 text-xs font-bold text-black shadow-md">Cochabamba</span>
          </div>
        </div>
      </div>

      <!-- Location Text -->
      <div class="text-center max-w-[480px]">
        <h2 class="font-['David_Libre',Helvetica] text-7xl font-bold leading-tight text-black lg:leading-[64px]">
          Estamos ubicados en Cochabamba
        </h2>
      </div>
    </div>
  </section>

  <!-- Requisitos para el registro Section -->
  <section class="mx-auto w-full max-w-[1308px] px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
    <div class="relative overflow-hidden rounded-[30px] bg-black px-6 py-14 text-center text-white shadow-2xl sm:px-12 lg:px-20 lg:py-20">
      <!-- Background floral watermark -->
      <img class="pointer-events-none absolute left-10 top-10 w-172" src="images/figma/svg/Clip_path_group__2001_20.svg" alt="" />
      <img class="pointer-events-none absolute -right-10 top-1/3 w-102 rotate-12" src="images/figma/svg/Clip_path_group__2003_872.svg" alt="" />
      <img class="pointer-events-none absolute -left-10 bottom-10 w-102 " src="images/figma/svg/Clip_path_group__2003_1100.svg" alt="" />

      <h2 class="relative z-10 font-['David_Libre',Helvetica] text-7xl font-bold lg:leading-[62px]">
        Requisitos para el registro
      </h2>
      <p class="relative z-10 mx-auto my-16 max-w-3xl font-['Inter',Helvetica] text-2xl text-white/80">
        Solo necesitamos algunos datos para agregar tu información y darte la bienvenida a nuestra comunidad.
      </p>

      <!-- Pill Badges Grid -->
      <div class="relative z-10 mx-auto mt-12 flex max-w-[850px] flex-wrap justify-center gap-x-4 gap-y-8 h-164">
        <div class="rounded-tl-[4rem] rounded-tr-xl rounded-br-[4rem] rounded-bl-xl h-14 max-h-24 bg-white px-16 py-3.5 font-['Inter',Helvetica] text-base text-black shadow-md sm:py-4 sm:text-lg">
          Nombre
        </div>
        <div class="rounded-tl-[4rem] rounded-tr-xl rounded-br-[4rem] rounded-bl-xl h-14 max-h-24 bg-white px-16 py-3.5 font-['Inter',Helvetica] text-base text-black shadow-md sm:py-4 sm:text-lg">
          Especialidades
        </div>
        <div class="rounded-tl-[4rem] rounded-tr-xl rounded-br-[4rem] rounded-bl-xl h-14 max-h-24 bg-white px-16 py-3.5 font-['Inter',Helvetica] text-base text-black shadow-md sm:py-4 sm:text-lg">
          Redes sociales o links
        </div>
        <div class="rounded-tl-[4rem] rounded-tr-xl rounded-br-[4rem] rounded-bl-xl h-14 max-h-24 bg-white px-20 py-3.5 font-['Inter',Helvetica] text-base text-black shadow-md sm:py-4 sm:text-lg">
          Nombre artístico
        </div>
        <div class="rounded-tl-[4rem] rounded-tr-xl rounded-br-[4rem] rounded-bl-xl h-14 max-h-24 bg-white px-20 py-3.5 font-['Inter',Helvetica] text-base text-black shadow-md sm:py-4 sm:text-lg">
          Número de celular
        </div>
        <div class="max-w-[320px] rounded-tl-[4rem] rounded-tr-xl rounded-br-[4rem] rounded-bl-xl h-26 bg-white px-20 py-4 font-['Inter',Helvetica] text-sm text-black shadow-md sm:text-base text-center">
          Portafolio de trabajos de cada estilo que realiza
        </div>
        <div class="max-w-[320px] rounded-tl-[4rem] rounded-tr-xl rounded-br-[4rem] rounded-bl-xl h-26 bg-white px-20 py-4 font-['Inter',Helvetica] text-sm text-black shadow-md sm:text-base text-center">
          Logros de Premios o Eventos (en caso de tener alguno)
        </div>
      </div>

      <!-- Habla con Nosotros Card -->
      <div class="relative z-10 mx-auto mt-16 max-w-240 h-80 rounded-tl-[6rem] rounded-tr-4xl rounded-br-[6rem] rounded-bl-4xl bg-[#1a1a1a] p-8 sm:p-10 border border-white/10 shadow-xl">
        <h3 class="font-['David_Libre',Helvetica] text-5xl font-bold text-white">
          Habla con Nosotros
        </h3>
        <p class="mt-2 font-['Inter',Helvetica] text-xl text-white/70">
          Haz Click en la red social que quieras
        </p>

        <div class="mt-8 flex justify-center items-center gap-10">
          <!-- TikTok -->
          <a href="https://www.tiktok.com/@blackitty.tattoo" target="_blank" rel="noopener noreferrer" class="flex h-28 w-28 items-center justify-center rounded-full border-2 border-white bg-white/0 text-white hover:bg-white hover:text-black transition-all hover:scale-110 shadow-lg" aria-label="TikTok">
            <svg class="h-18 w-18 fill-current text-white" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.29 0 .56.04.83.1v-3.6a6.38 6.38 0 0 0-1-.08A6.33 6.33 0 0 0 3 15.42a6.33 6.33 0 0 0 10.86 4.46V11.2a8.27 8.27 0 0 0 5.73 2.16V9.82a4.83 4.83 0 0 1-3.77-4.25z"/>
            </svg>
          </a>
          <!-- Phone / WhatsApp -->
          <a href="https://api.whatsapp.com/send?phone=59176138478&text=Hola!" target="_blank" rel="noopener noreferrer" class="flex h-28 w-28 items-center justify-center rounded-full border-2 border-white bg-white/0 text-white hover:bg-white hover:text-black transition-all hover:scale-110 shadow-lg" aria-label="WhatsApp">
            <svg class="h-18 w-18 fill-current text-white" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
          </a>
          <!-- Instagram -->
          <a href="https://www.instagram.com/blackitty.tattoo/" target="_blank" rel="noopener noreferrer" class="flex h-28 w-28 items-center justify-center rounded-full border-2 border-white bg-white/0 text-white hover:bg-white hover:text-black transition-all hover:scale-110 shadow-lg" aria-label="Instagram">
            <svg class="h-18 w-18 fill-current text-white" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>