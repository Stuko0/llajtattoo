---
import Layout from "../layouts/Layout.astro";
import NewsPills from "../components/NewsPills.tsx";
import StarRating from "../components/StarRating.tsx";
---

<Layout title="Inicio" currentPage="inicio">
  <!-- Hero Section -->
  <section id="inicio" class="mx-auto w-full max-w-[1308px] px-4 pb-8 pt-2 sm:px-6 lg:px-8 lg:pb-16 lg:pt-6" aria-labelledby="welcome-title">
    <div class="grid overflow-hidden rounded-[30px] border border-black/10 bg-white shadow-[0px_4px_20px_rgba(0,0,0,0.08)] lg:grid-cols-[1fr_450px]">
      <div class="flex min-h-[220px] flex-col justify-center px-6 py-10 sm:px-12 lg:min-h-[480px] lg:px-16">
        <h1 id="welcome-title" class="max-w-[620px] font-['David_Libre',Helvetica] text-3xl font-bold leading-tight sm:text-5xl lg:text-[68px] lg:leading-[72px] text-black">
          Bienvenido a nuestra comunidad
        </h1>
        <p class="mt-6 max-w-[618px] font-['Inter',Helvetica] text-sm leading-relaxed text-[#5c6674] sm:text-base sm:leading-[28px] lg:text-lg">
          Esta página está hecha para ti. Descubre la gran comunidad de tatuadores de Cochabamba, encuentra el estilo que buscas, conecta con tu artista favorito y agenda tu cita. ¡Tu próximo tatuaje comienza aquí!
        </p>
      </div>
      <div class="flex items-center justify-center p-6 bg-[#fafafa]">
        <img
          class="h-auto w-full max-w-[380px] object-contain"
          src="/images/assets/spider-hero.png"
          alt="Diseño artístico de tatuaje"
        >
      </div>
    </div>
  </section>

  <!-- Artistas del mes -->
  <section id="artistas" class="relative mx-auto w-full max-w-[1308px] px-4 py-12 text-center sm:px-6 lg:px-8 lg:py-16" aria-labelledby="artists-title">
    <img
      class="pointer-events-none absolute right-0 top-0 hidden w-48 object-contain opacity-40 lg:block"
      src="/images/assets/flower.png"
      alt=""
    >
    <h2 id="artists-title" class="font-['David_Libre',Helvetica] text-3xl font-bold leading-none sm:text-4xl lg:text-[68px]">
      Artistas del mes
    </h2>
    <p class="mx-auto mt-4 max-w-[500px] font-['Inter',Helvetica] text-sm text-[#5c6674] sm:text-base">
      Los artistas más destacados del mes por su participación en la convención de tatuajes en Oruro
    </p>
    <div class="mx-auto mt-12 grid max-w-[950px] grid-cols-1 gap-8 sm:grid-cols-3 items-start lg:mt-16">
      <article class="flex flex-col items-center">
        <img
          class="h-28 w-28 rounded-full object-cover sm:h-36 sm:w-36 lg:h-[190px] lg:w-[190px] shadow-lg border-2 border-black/10"
          src="/images/assets/Profe Tattoo.png"
          alt="Fabian Morales, Profe Tattoo"
        >
        <h3 class="mt-4 font-['David_Libre',Helvetica] text-lg font-bold text-black sm:text-xl">
          Fabian Morales<br><span class="text-xs font-bold text-[#5c6674] uppercase">PROFE TATTOO</span>
        </h3>
        <a href="/artistas" class="mt-3 rounded-full bg-[#101a24] px-6 py-2 font-['Inter',Helvetica] text-xs font-bold text-white hover:bg-black transition-colors shadow-md">
          Ver Perfil
        </a>
      </article>

      <!-- Staggered center card -->
      <article class="flex flex-col items-center lg:mt-12">
        <img
          class="h-28 w-28 rounded-full object-cover sm:h-36 sm:w-36 lg:h-[190px] lg:w-[190px] shadow-lg border-2 border-black/10"
          src="/images/assets/Don Juan Caballero.png"
          alt="Juan Don Juan Caballero"
        >
        <h3 class="mt-4 font-['David_Libre',Helvetica] text-lg font-bold text-black sm:text-xl">
          Juan<br><span class="text-xs font-bold text-[#5c6674] uppercase">Don Juan Caballero</span>
        </h3>
        <a href="/artistas" class="mt-3 rounded-full bg-[#101a24] px-6 py-2 font-['Inter',Helvetica] text-xs font-bold text-white hover:bg-black transition-colors shadow-md">
          Ver Perfil
        </a>
      </article>

      <article class="flex flex-col items-center">
        <img
          class="h-28 w-28 rounded-full object-cover sm:h-36 sm:w-36 lg:h-[190px] lg:w-[190px] shadow-lg border-2 border-black/10"
          src="/images/assets/Black Kitty.png"
          alt="Natalia Lazzo, Blackitty"
        >
        <h3 class="mt-4 font-['David_Libre',Helvetica] text-lg font-bold text-black sm:text-xl">
          Natalia Lazzo<br><span class="text-xs font-bold text-[#5c6674] uppercase">BLACKITTY</span>
        </h3>
        <a href="https://www.instagram.com/blackitty.tattoo/" target="_blank" rel="noopener noreferrer" class="mt-3 rounded-full bg-[#101a24] px-6 py-2 font-['Inter',Helvetica] text-xs font-bold text-white hover:bg-black transition-colors shadow-md">
          Ver Perfil
        </a>
      </article>
    </div>
  </section>

  <!-- Noticias Section -->
  <section id="noticias" class="relative overflow-hidden bg-[#e9e9e9] px-4 py-12 text-center sm:px-6 lg:py-20" aria-labelledby="news-title">
    <img
      class="pointer-events-none absolute left-0 top-0 hidden w-72 opacity-30 lg:block"
      src="/images/assets/flower.png"
      alt=""
    >
    <img
      class="pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 hidden w-72 opacity-30 lg:block"
      src="/images/assets/flower.png"
      alt=""
    >
    <div class="relative mx-auto max-w-[1308px] px-4 sm:px-6 lg:px-8">
      <h2 id="news-title" class="font-['David_Libre',Helvetica] text-3xl font-bold sm:text-4xl lg:text-[68px]">
        Noticias
      </h2>
      <p class="mx-auto mt-4 max-w-[700px] font-['Inter',Helvetica] text-sm text-[#5c6674] sm:text-base lg:text-lg">
        Descubre las últimas tendencias del mundo del tatuaje y entérate de las noticias más importantes sobre eventos, convenciones y festivales de tattoo en Bolivia y alrededor del mundo.
      </p>
      <div class="my-8">
        <NewsPills client:load />
      </div>
      <a href="/blog" class="inline-block rounded-full bg-[#07111a] px-12 py-3.5 font-['David_Libre',Helvetica] text-lg font-bold text-white shadow-lg hover:bg-black transition-all hover:scale-105">
        Ingresar
      </a>
    </div>
  </section>

  <!-- CTA 3 Cards Section -->
  <section class="mx-auto grid w-full max-w-[1308px] gap-6 px-4 py-12 sm:px-6 md:grid-cols-3 lg:px-8 lg:py-20" aria-label="Opciones de la comunidad">
    <!-- Card 1 -->
    <article class="flex min-h-[380px] flex-col justify-between rounded-[30px] bg-black px-7 py-8 text-center text-white shadow-xl">
      <div>
        <h2 class="font-['David_Libre',Helvetica] text-xl font-bold leading-tight sm:text-2xl lg:text-[26px]">
          ¿NO SABES QUÉ ESTILO ES EL TATUAJE QUE QUIERES REALIZARTE?
        </h2>
        <div class="mt-6 flex items-center gap-4 text-left">
          <img class="h-24 w-24 rounded-full object-cover shrink-0 border border-white/20" src="/images/assets/new4.png" alt="Tatuaje estilo">
          <p class="font-['Inter',Helvetica] text-xs leading-relaxed text-white/80 sm:text-sm">
            Ingresa a la pestaña de estilos y encuentra el estilo de tu tatuaje con las características de cada estilo.
          </p>
        </div>
      </div>
      <a href="/estilos" class="mt-8 inline-block rounded-full bg-white px-8 py-3.5 font-['Inter',Helvetica] text-sm font-bold text-black hover:bg-[#dcdcdc] transition-all">
        IR A ESTILOS
      </a>
    </article>

    <!-- Card 2 -->
    <article class="flex min-h-[380px] flex-col justify-between rounded-[30px] bg-black px-7 py-8 text-center text-white shadow-xl">
      <div>
        <h2 class="font-['David_Libre',Helvetica] text-2xl font-bold leading-tight sm:text-3xl lg:text-[32px]">
          Eres artista ?
        </h2>
        <p class="mt-6 font-['Inter',Helvetica] text-sm leading-relaxed text-white/80 sm:text-base">
          Únete a nuestra comunidad de artistas, conecta con nuevos clientes y disfruta de todos los beneficios que ofrece nuestra plataforma.
        </p>
      </div>
      <a href="/unete" class="mt-8 inline-block rounded-full bg-white px-8 py-3.5 font-['Inter',Helvetica] text-sm font-bold text-black hover:bg-[#dcdcdc] transition-all">
        APLICAR AHORA
      </a>
    </article>

    <!-- Card 3 -->
    <article class="flex min-h-[380px] flex-col justify-between rounded-[30px] bg-black px-7 py-8 text-center text-white shadow-xl">
      <div>
        <h2 class="font-['David_Libre',Helvetica] text-xl font-bold leading-tight sm:text-2xl lg:text-[24px]">
          ¡ESTE TATUADOR ESTÁ DE PROMOCIÓN ESTE MES!
        </h2>
        <p class="mt-3 font-['Inter',Helvetica] text-xs text-white/75 sm:text-sm">
          ingresa a su perfil para ver su trabajo y conocer más sobre ella
        </p>
        <div class="mt-4 flex justify-center">
          <img class="h-24 w-24 rounded-full object-cover border-2 border-white/20 shadow-md" src="/images/assets/Black Kitty.png" alt="Black Kitty">
        </div>
      </div>
      <a href="https://www.instagram.com/blackitty.tattoo/" target="_blank" rel="noopener noreferrer" class="mt-6 inline-block rounded-full bg-[#f72b8e] px-8 py-3.5 font-['Inter',Helvetica] text-base font-bold text-white hover:bg-[#df159f] transition-all shadow-md">
        2 X 1 FINELINE
      </a>
    </article>
  </section>

  <!-- Explorar por estilos Grid -->
  <section id="estilos" class="mx-auto w-full max-w-[1308px] px-4 py-8 sm:px-6 lg:px-8 lg:py-16" aria-labelledby="styles-title">
    <h2 id="styles-title" class="text-center font-['David_Libre',Helvetica] text-3xl font-bold sm:text-4xl lg:text-[68px]">
      Explorar por estilos
    </h2>
    <div class="mx-auto mt-12 grid max-w-[1000px] grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      <!-- Style Card 1 -->
      <article class="overflow-hidden rounded-[30px] bg-black text-center text-white shadow-lg flex flex-col justify-between hover:scale-[1.02] transition-transform">
        <div class="p-6 pb-4">
          <img class="mx-auto h-44 w-44 object-cover rounded-2xl" src="/images/assets/traditional-home.png" alt="Tatuaje tradicional">
          <h3 class="mt-4 font-['Inter',Helvetica] text-2xl font-bold">Estilo</h3>
          <p class="font-['Inter',Helvetica] text-base text-white/80">tradicional</p>
        </div>
        <a href="/estilos" class="flex h-12 items-center justify-center bg-[#dcdcdc] font-['Inter',Helvetica] text-sm font-bold text-black hover:bg-white transition-colors">INGRESAR</a>
      </article>

      <!-- Style Card 2 -->
      <article class="overflow-hidden rounded-[30px] bg-black text-center text-white shadow-lg flex flex-col justify-between hover:scale-[1.02] transition-transform">
        <div class="p-6 pb-4">
          <img class="mx-auto h-44 w-44 object-cover rounded-2xl" src="/images/assets/fine-line-home.png" alt="Tatuaje fine line">
          <h3 class="mt-4 font-['Inter',Helvetica] text-2xl font-bold">Estilo</h3>
          <p class="font-['Inter',Helvetica] text-base text-white/80">Fine line</p>
        </div>
        <a href="/estilos" class="flex h-12 items-center justify-center bg-[#dcdcdc] font-['Inter',Helvetica] text-sm font-bold text-black hover:bg-white transition-colors">INGRESAR</a>
      </article>

      <!-- Style Card 3 -->
      <article class="overflow-hidden rounded-[30px] bg-black text-center text-white shadow-lg flex flex-col justify-between hover:scale-[1.02] transition-transform">
        <div class="p-6 pb-4">
          <img class="mx-auto h-44 w-44 object-cover rounded-2xl" src="/images/assets/neo-traditional-home.png" alt="Tatuaje neotradicional">
          <h3 class="mt-4 font-['Inter',Helvetica] text-2xl font-bold">Estilo</h3>
          <p class="font-['Inter',Helvetica] text-base text-white/80">Neotradicional</p>
        </div>
        <a href="/estilos" class="flex h-12 items-center justify-center bg-[#dcdcdc] font-['Inter',Helvetica] text-sm font-bold text-black hover:bg-white transition-colors">INGRESAR</a>
      </article>

      <!-- Style Card 4 -->
      <article class="overflow-hidden rounded-[30px] bg-black text-center text-white shadow-lg flex flex-col justify-between hover:scale-[1.02] transition-transform">
        <div class="p-6 pb-4">
          <img class="mx-auto h-44 w-44 object-cover rounded-2xl" src="/images/assets/blackwork.png" alt="Tatuaje blackwork">
          <h3 class="mt-4 font-['Inter',Helvetica] text-2xl font-bold">Estilo</h3>
          <p class="font-['Inter',Helvetica] text-base text-white/80">Blackwork</p>
        </div>
        <a href="/estilos" class="flex h-12 items-center justify-center bg-[#dcdcdc] font-['Inter',Helvetica] text-sm font-bold text-black hover:bg-white transition-colors">INGRESAR</a>
      </article>

      <!-- Style Card 5 -->
      <article class="overflow-hidden rounded-[30px] bg-black text-center text-white shadow-lg flex flex-col justify-between hover:scale-[1.02] transition-transform">
        <div class="p-6 pb-4">
          <img class="mx-auto h-44 w-44 object-cover rounded-2xl" src="/images/assets/realism1-home.png" alt="Tatuaje realista">
          <h3 class="mt-4 font-['Inter',Helvetica] text-2xl font-bold">Estilo</h3>
          <p class="font-['Inter',Helvetica] text-base text-white/80">Realismo</p>
        </div>
        <a href="/estilos" class="flex h-12 items-center justify-center bg-[#dcdcdc] font-['Inter',Helvetica] text-sm font-bold text-black hover:bg-white transition-colors">INGRESAR</a>
      </article>

      <!-- Style Card 6 -->
      <article class="overflow-hidden rounded-[30px] bg-black text-center text-white shadow-lg flex flex-col justify-between hover:scale-[1.02] transition-transform">
        <div class="p-6 pb-4">
          <img class="mx-auto h-44 w-44 object-cover rounded-2xl" src="/images/assets/realism2-home.png" alt="Tatuaje realista">
          <h3 class="mt-4 font-['Inter',Helvetica] text-2xl font-bold">Estilo</h3>
          <p class="font-['Inter',Helvetica] text-base text-white/80">Realismo</p>
        </div>
        <a href="/estilos" class="flex h-12 items-center justify-center bg-[#dcdcdc] font-['Inter',Helvetica] text-sm font-bold text-black hover:bg-white transition-colors">INGRESAR</a>
      </article>
    </div>
  </section>

  <!-- 3 Pasos Section -->
  <section class="relative overflow-hidden bg-black px-4 py-16 text-white sm:px-6 lg:py-24" aria-labelledby="steps-title">
    <!-- Flower watermark left -->
    <img class="pointer-events-none absolute bottom-0 left-0 hidden w-80 opacity-20 lg:block" src="/images/assets/flower.png" alt="">

    <div class="relative mx-auto max-w-[1308px] px-4 sm:px-6 lg:px-8">
      <h2 id="steps-title" class="text-center font-['David_Libre',Helvetica] text-3xl font-bold sm:text-4xl lg:text-[68px]">
        Tu próximo tatuaje en <span class="font-bold text-white">3 pasos</span>
      </h2>
      <p class="mt-4 text-center font-['Inter',Helvetica] text-sm text-white/80 sm:text-base lg:text-lg">
        Sigue estos tres pasos para realizarte un tatuaje
      </p>

      <ol class="mt-16 grid grid-cols-1 gap-12 md:grid-cols-3 items-start lg:mt-24">
        <!-- Step 1 -->
        <li class="relative rounded-[40px] bg-white p-8 pt-16 text-center text-black shadow-2xl">
          <span class="absolute -top-12 left-1/2 flex h-24 w-24 -translate-x-1/2 items-center justify-center rounded-full bg-white shadow-lg border-4 border-black">
            <svg class="h-10 w-10 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
            </svg>
          </span>
          <h3 class="font-['David_Libre',Helvetica] text-2xl font-bold">EXPLORA</h3>
          <p class="mt-4 font-['Inter',Helvetica] text-sm leading-relaxed text-[#5c6674]">
            Explora la página para descubrir promociones, artistas y las últimas noticias del mundo del tatuaje. Si ya tienes un estilo en mente, elige a tu tatuador de acuerdo con su especialidad y conecta con el artista que mejor se adapte a tus gustos.
          </p>
        </li>

        <!-- Step 2 (Staggered lower) -->
        <li class="relative rounded-[40px] bg-white p-8 pt-16 text-center text-black shadow-2xl lg:mt-16">
          <span class="absolute -top-12 left-1/2 flex h-24 w-24 -translate-x-1/2 items-center justify-center rounded-full bg-white shadow-lg border-4 border-black">
            <svg class="h-10 w-10 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </span>
          <h3 class="font-['David_Libre',Helvetica] text-2xl font-bold">AGENDA</h3>
          <p class="mt-4 font-['Inter',Helvetica] text-sm leading-relaxed text-[#5c6674]">
            Si ya escogiste a tu tatuador, puedes ingresar a sus redes sociales para interactuar con él, enviarle un mensaje y agendar una cita.
          </p>
        </li>

        <!-- Step 3 -->
        <li class="relative rounded-[40px] bg-white p-8 pt-16 text-center text-black shadow-2xl">
          <span class="absolute -top-12 left-1/2 flex h-24 w-24 -translate-x-1/2 items-center justify-center rounded-full bg-white shadow-lg border-4 border-black">
            <svg class="h-10 w-10 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
          </span>
          <h3 class="font-['David_Libre',Helvetica] text-2xl font-bold">TATÚATE</h3>
          <p class="mt-4 font-['Inter',Helvetica] text-sm leading-relaxed text-[#5c6674]">
            Una vez que agendes tu cita, tatúate y disfruta de tu nuevo tatuaje.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Rating Section -->
  <StarRating client:load />
</Layout>
