---
import Layout from "../layouts/Layout.astro";
import NewsPills from "../components/NewsPills";

const blogPosts = [
  {
    id: 1,
    img: "/images/assets/spider-leg.jpg",
    author: "BLACK KITTY",
  }
  ,
  {
    id: 2,
    img: "/images/assets/neo-traditional-home.png",
    author: "DON JUAN CABALLERO",
  },
  {
    id: 3,
    img: "/images/assets/blackwork.png",
    author: "PISTACHO",
  },
  {
    id: 4,
    img: "/images/assets/krosty.jpg",
    author: "PROFE TATTOO",
  },
  {
    id: 5,
    img: "/images/assets/sahlo.jpg",
    author: "BLACK KITTY",
  },
  {
    id: 6,
    img: "/images/assets/colibri.jpg",
    author: "PROFE TATTOO",
  }
];
---

<Layout title="Blog" currentPage="blog">
  <!-- Hero Section Banner -->
  <section id="inicio" class="mx-auto w-full max-w-[1308px] px-4 pb-8 pt-2 sm:px-6 lg:px-8 lg:pb-16 lg:pt-6" aria-labelledby="welcome-title">
      <div class="grid overflow-hidden border border-black/10 border-t-0 bg-white shadow-[0px_4px_20px_rgba(0,0,0,0.08)] lg:grid-cols-[1fr_450px]">
        <div class="flex min-h-[220px] flex-col justify-center px-6 py-10 sm:px-12 lg:min-h-[480px] lg:px-16">
          <h1 id="welcome-title" class="max-w-[620px] font-['David_Libre',Helvetica] text-3xl font-bold leading-tight sm:text-5xl lg:text-[68px] lg:leading-[72px] text-black">
              BLOG DEL TATUAJE
          </h1>
          <p class="mt-6 max-w-[618px] font-['Inter',Helvetica] text-sm leading-relaxed text-[#5c6674] sm:text-base sm:leading-[28px] lg:text-lg">
              Explora la cultura, historia y evolución del tatuaje a través de artículos detallados, entrevistas exclusivas con artistas y recomendaciones para el cuidado de tu piel.
          </p>
        </div>
        <div class="flex items-center justify-center px-6 bg-[#ffffff]">
          <img
            class="h-auto max-h-96 w-full max-w-[380px] object-contain"
            src="/images/assets/blog-hero.jpg"
            alt="Diseño artístico de tatuaje"
          >
        </div>
      </div>
    </section>
<img class="pointer-events-none absolute -left-24 top-236 w-86 -rotate-6" src="images/figma/svg/Clip_path_group__2003_762.svg" alt="" />
  <!-- Blog Posts Grid -->
  <section class="mx-auto w-full max-w-[930px] px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {blogPosts.map((post) => (
        <article class="group overflow-hidden rounded-[25px] bg-[#f6f6f6] border border-black/10 shadow-md hover:shadow-2xl transition-all duration-300 flex flex-col">
          <div class="relative h-55 w-55 overflow-hidden my-12 mx-6">
            <img
              src={post.img}
              alt="Trabajo del Artista"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 rounded-4xl"
            />
          </div>
          <div class="px-6 flex flex-col flex-1 justify-between text-center">
            <div>
              <h2 class="font-['David_Libre',Helvetica] text-2xl font-bold text-black group-hover:text-[#000000] leading-snug">
                Trabajo del Artista:
              </h2>
              <p class="my-2 font-['Inter',Helvetica] text-xl text-black leading-relaxed">
                {post.author}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Noticias Split Section -->
  <section class="relative overflow-hidden mx-auto w-full h-192 py-12 lg:py-16 bg-[#e9e9e9]">
  <img class="pointer-events-none absolute -right-29 top-[30%] w-86 -translate-y-1/2" src="images/assets/flower.png" alt="" />
    <div class="flex flex-col lg:flex-row justify-center mt-20">
      <div class="max-w-[500px] flex flex-col justify-start text-center mr-20">
        <h2 class="font-['David_Libre',Helvetica] text-3xl font-bold sm:text-4xl lg:text-[48px] text-black">
          Noticias
        </h2>
        <p class="mt-4 font-['Inter',Helvetica] text-lg text-black leading-relaxed text-justify">
            Las tendencias actuales en el mundo del tatuaje muestran un creciente interés por la autoexpresión personalizada. Entre los estilos más populares destacan los microtatuajes, el neotradicional y el blackwork. Asimismo, los estudios de tatuaje registran una mayor demanda de piezas que fusionan técnicas tradicionales con composiciones diseñadas para integrarse de manera armónica con la forma y el movimiento natural del cuerpo.
        </p>
      </div>
      <div class="w-175">
    <NewsPills client:load maxWidth="700px" height="470px"/>
      </div>
    </div>
  </section>

  <!-- Bottom Registration CTA Banner -->
  <section class="relative mx-auto w-full max-w-[1308px] rounded-4xl bg-[#242424] h-86 mt-40 overflow-hidden">
    <div class="relative h-full overflow-hidden px-8 text-center text-white shadow-2xl sm:px-14 lg:px-20 flex flex-col items-center justify-center">
      <!-- Watermark background illustration -->
      <img class="pointer-events-none absolute object-cover w-full" src="/images/assets/suscribe-bg.png" alt="" />
      <h2 class="relative z-10 font-['David_Libre',Helvetica] text-4xl font-bold pt-20 lg:leading-[60px] max-w-3xl">
        Disfruta de los beneficios y regístrate AHORA!
      </h2>
      <a href="/unete" class="relative z-10 mt-8 inline-block rounded-full bg-white px-12 py-4 font-['Inter',Helvetica] text-base font-bold text-black hover:bg-[#dcdcdc] transition-all shadow-xl hover:scale-105">
        Registrate
      </a>
    </div>
  </section>
</Layout>