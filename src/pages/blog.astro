---
import Layout from "../layouts/Layout.astro";
import NewsPills from "../components/NewsPills";

const blogPosts = [
  {
    id: 1,
    title: "Trabajo del Artista: Fabian Morales",
    subtitle: "Maestro del tatuaje tradicional y realismo en Cochabamba.",
    img: "/images/assets/Profe Tattoo.jpg",
    author: "Fabian Morales",
    date: "12 Oct 2024"
  },
  {
    id: 2,
    title: "Trabajo del Artista: Don Juan Caballero",
    subtitle: "Dominando el color intenso y Neotradicional con maestría.",
    img: "/images/assets/Don Juan Caballero.jpg",
    author: "Juan Caballero",
    date: "08 Oct 2024"
  },
  {
    id: 3,
    title: "Trabajo del Artista: Natalia Lazzo",
    subtitle: "Especialista en Fine Line y diseños delicados de alta precisión.",
    img: "/images/assets/Black Kitty.png",
    author: "Natalia Lazzo",
    date: "01 Oct 2024"
  },
  {
    id: 4,
    title: "Trabajo del Artista: Ignacio Orihuela",
    subtitle: "El nuevo referente del estilo New School y piezas ilustrativas.",
    img: "/images/assets/new2.png",
    author: "Ignacio Orihuela",
    date: "25 Sep 2024"
  },
  {
    id: 5,
    title: "Innovación en Blackwork y Parche",
    subtitle: "Tendencias de tatuaje textil y tintas de alta concentración.",
    img: "/images/assets/blackwork.png",
    author: "Natalia Lazzo",
    date: "18 Sep 2024"
  },
  {
    id: 6,
    title: "Guía completa para el cuidado de tu tatuaje",
    subtitle: "Pasos fundamentales para mantener tus piezas vivas por años.",
    img: "/images/assets/realism1-home.png",
    author: "Fabian Morales",
    date: "10 Sep 2024"
  }
];
---

<Layout title="Blog" currentPage="blog">
  <!-- Hero Section Banner -->
  <section class="mx-auto w-full max-w-[1308px] px-4 py-6 sm:px-6 lg:px-8 lg:py-10">
    <div class="relative overflow-hidden rounded-[30px] bg-[#e9e9e9] px-8 py-12 text-black shadow-sm sm:px-14 sm:py-16 lg:px-20 lg:py-16 flex flex-col lg:flex-row items-center justify-between gap-10 border border-black/5">
      <div class="z-10 max-w-[620px]">
        <h1 class="font-['David_Libre',Helvetica] text-4xl font-bold leading-tight sm:text-5xl lg:text-[68px] lg:leading-[75px] text-black">
          BLOG DEL TATUAJE
        </h1>
        <p class="mt-6 font-['Inter',Helvetica] text-sm leading-relaxed text-black/80 sm:text-base sm:leading-[28px] lg:text-lg">
          Explora la cultura, historia y evolución del tatuaje a través de artículos detallados, entrevistas exclusivas con artistas y recomendaciones para el cuidado de tu piel.
        </p>
      </div>
      <div class="relative w-full max-w-[320px] flex justify-center lg:justify-end">
        <img src="/images/assets/flower.png" alt="Ilustración decorativa" class="w-full max-w-[260px] h-auto object-contain opacity-70" />
      </div>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="mx-auto w-full max-w-[1308px] px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {blogPosts.map((post) => (
        <article class="group overflow-hidden rounded-[25px] bg-white border border-black/10 shadow-md hover:shadow-2xl transition-all duration-300 flex flex-col">
          <div class="relative h-[260px] w-full overflow-hidden bg-black">
            <img
              src={post.img}
              alt={post.title}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          </div>
          <div class="p-6 flex flex-col flex-1 justify-between">
            <div>
              <span class="text-xs font-semibold text-[#f72b8e] tracking-wider uppercase">{post.date}</span>
              <h2 class="mt-2 font-['David_Libre',Helvetica] text-2xl font-bold text-black group-hover:text-[#000000] leading-snug">
                {post.title}
              </h2>
              <p class="mt-3 font-['Inter',Helvetica] text-sm text-[#5c6674] leading-relaxed">
                {post.subtitle}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-black/10 flex items-center justify-between">
              <span class="font-['Inter',Helvetica] text-xs font-bold text-black/70">{post.author}</span>
              <span class="font-['Inter',Helvetica] text-xs font-bold text-black group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Leer más &rarr;
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Noticias Split Section -->
  <section class="mx-auto w-full max-w-[1308px] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="rounded-[30px] bg-[#e9e9e9] p-8 sm:p-12 lg:p-16 border border-black/5 flex flex-col lg:flex-row items-center justify-between gap-10">
      <div class="max-w-[500px]">
        <h2 class="font-['David_Libre',Helvetica] text-3xl font-bold sm:text-4xl lg:text-[48px] text-black">
          Noticias
        </h2>
        <p class="mt-4 font-['Inter',Helvetica] text-base text-[#5c6674] leading-relaxed">
          Descubre las últimas tendencias del mundo del tatuaje y entérate de las noticias más importantes sobre eventos, convenciones y festivales de tattoo en Bolivia y alrededor del mundo.
        </p>
        <a href="#noticias-grid" class="mt-6 inline-block rounded-full bg-black px-8 py-3 font-['Inter',Helvetica] text-sm font-bold text-white hover:bg-[#1a1a1a] transition-all">
          Ver todas
        </a>
      </div>
      <div class="w-full max-w-[450px]">
        <NewsPills client:load />
      </div>
    </div>
  </section>

  <!-- Bottom Registration CTA Banner -->
  <section class="mx-auto w-full max-w-[1308px] px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
    <div class="relative overflow-hidden rounded-[30px] bg-black px-8 py-14 text-center text-white shadow-2xl sm:px-14 lg:px-20 lg:py-20 flex flex-col items-center justify-center">
      <!-- Watermark background illustration -->
      <img class="pointer-events-none absolute left-0 top-0 w-64 opacity-10" src="/images/assets/flower.png" alt="" />
      <img class="pointer-events-none absolute right-0 bottom-0 w-64 opacity-10" src="/images/assets/flower.png" alt="" />

      <h2 class="relative z-10 font-['David_Libre',Helvetica] text-3xl font-bold sm:text-4xl lg:text-[52px] lg:leading-[60px] max-w-2xl">
        Disfruta de los beneficios y regístrate AHORA!
      </h2>
      <a href="/unete" class="relative z-10 mt-8 inline-block rounded-full bg-white px-12 py-4 font-['Inter',Helvetica] text-base font-bold text-black hover:bg-[#dcdcdc] transition-all shadow-xl hover:scale-105">
        Registrate
      </a>
    </div>
  </section>
</Layout>