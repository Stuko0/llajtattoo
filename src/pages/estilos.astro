---
import Layout from "../layouts/Layout.astro";
import StyleAccordion from "../components/StyleAccordion";
---

<Layout title="Estilos" currentPage="estilos">
  <!-- Hero Section Banner -->
  <section class="mx-auto w-full max-w-[1308px] px-4 py-6 sm:px-6 lg:px-8 lg:py-10">
    <div class="relative overflow-hidden rounded-[30px] bg-black px-8 py-12 text-white shadow-[0px_4px_20px_rgba(0,0,0,0.2)] sm:px-14 sm:py-16 lg:px-20 lg:py-16 flex items-center justify-between min-h-[260px]">
      <div class="z-10">
        <h1 class="font-['David_Libre',Helvetica] text-4xl font-bold leading-tight sm:text-5xl lg:text-[70px] text-white">
          ESTILOS
        </h1>
      </div>
      <div class="relative w-full max-w-[400px] flex justify-end">
        <img src="/images/assets/dragon-in-black.png" alt="Diseño de tatuaje" class="w-full max-w-[320px] h-auto object-contain opacity-80 filter drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)]" />
      </div>
    </div>
  </section>

  <!-- Interactive Style Exploration Section -->
  <section class="relative mx-auto w-full max-w-[1308px] px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
    <StyleAccordion client:load />

    <!-- Bottom background tattoo illustration watermark -->
    <div class="mt-16 flex justify-end">
      <img src="/images/assets/tattoo-background.png" alt="" class="w-full max-w-[450px] opacity-80 pointer-events-none" />
    </div>
  </section>
</Layout>