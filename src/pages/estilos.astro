---
import Layout from "../layouts/Layout.astro";
import StyleAccordion from "../components/StyleAccordion";
---

<Layout title="Estilos" currentPage="estilos">
  <!-- Hero Section Banner -->
  <section class="mx-auto w-full max-w-327 px-4 py-6 sm:px-6 lg:px-8 lg:py-10">
    <div class="relative rounded-[30px] bg-black px-2 py-2 text-white shadow-[0px_4px_20px_rgba(0,0,0,0.2)] flex items-start justify-between min-h-[260px]">
      <div class="">
        <img src="/images/assets/flowers-in-black.png" alt="Diseño de tatuaje" class="w-260" />
        <h1 class="font-['David_Libre',Helvetica] mx-32 z-10 text-4xl font-bold leading-tight sm:text-5xl lg:text-[70px] text-white">
          ESTILOS
        </h1>
      </div>
      <div class="relative w-full flex justify-end">
        <!-- Dragón: alineado arriba, sale del banner; z-5 = sobre zona clara, bajo cards y zona negra -->
        <img src="/images/assets/dragon-in-black.png" alt="Diseño de tatuaje" class="relative z-[5] -mt-36 w-full max-w-[420px] h-auto" />
      </div>
    </div>
  </section>

  <!-- Interactive Style Exploration Section -->
  <section class="relative mx-auto w-full max-w-[1308px] px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
    <!-- Ramas decorativas de fondo -->
    <img class="pointer-events-none absolute right-0 top-0 hidden w-48 opacity-30 lg:block" src="/images/assets/branch.png" alt="" />
    <img class="pointer-events-none absolute left-0 top-1/2 hidden w-48 -translate-y-1/2 opacity-30 lg:block" src="/images/assets/branch.png" alt="" />

    <StyleAccordion client:load />

    <!-- Bottom background tattoo illustration watermark -->
    <div class="flex justify-end">
      <img src="/images/assets/tattoo-background.png" alt="" class="w-full max-w-[450px] opacity-80 pointer-events-none" />
    </div>
  </section>
</Layout>