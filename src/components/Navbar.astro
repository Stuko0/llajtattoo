---
export interface Props {
  currentPage?: string;
  /** "dark" = navbar invertido (fondo negro, texto blanco) para vistas de perfil */
  theme?: "light" | "dark";
}
const { currentPage = "inicio", theme = "light" } = Astro.props;
const dark = theme === "dark";
const links = [
  { href: "/", label: "Inicio", id: "inicio" },
  { href: "/estilos", label: "Estilos", id: "estilos" },
  { href: "/artistas", label: "Artistas", id: "artistas" },
  { href: "/unete", label: "Únete", id: "unete" },
  { href: "/blog", label: "Blog", id: "blog" },
];
---

<header class={`w-full ${dark ? "bg-black" : "bg-white"}`}>
  <div class="mx-auto flex w-full max-w-[1308px] items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8 lg:py-8">
    <a href="/" class="shrink-0" aria-label="Llajtattoo, ir al inicio">
      <img class={`h-auto w-[120px] object-contain sm:w-[180px] lg:w-[280px] ${dark ? "invert" : ""}`} src="/images/logo.png" alt="Llajtattoo">
    </a>

    <nav class="hidden items-center gap-6 lg:flex xl:gap-10" aria-label="Navegación principal">
      {links.map((link) => (
        <a
          href={link.href}
          class={`font-['Inter',Helvetica] text-[26px] xl:text-[32px] font-normal leading-tight transition-colors ${
            currentPage === link.id
              ? `font-medium ${dark ? "text-[#666666]" : "text-[#999999]"}`
              : `${dark ? "text-white hover:text-[#666666]" : "text-black hover:text-[#999999]"}`
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <form class={`hidden items-center rounded-full px-5 py-2 sm:flex h-[44px] shrink-0 ${dark ? "bg-white" : "bg-black"}`} role="search">
      <label for="site-search" class="sr-only">Buscar estilo</label>
      <svg class={`mr-2.5 h-6 w-6 shrink-0 ${dark ? "text-black" : "text-white"}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <input
        id="site-search"
        name="search"
        type="search"
        placeholder="Buscar estilo"
        class={`w-24 border-0 bg-transparent font-['Inter',Helvetica] text-base font-medium outline-none lg:w-[130px] ${dark ? "text-black placeholder:text-[#666666]" : "text-white placeholder:text-[#999999]"}`}
      >
    </form>
  </div>
</header>