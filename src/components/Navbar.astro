---
// Navbar — exact structure from anima_output.html
---

<header class="mx-auto flex w-full max-w-[1150px] items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-0 lg:py-6">
  <a href="/" class="shrink-0" aria-label="Llajtattoo, ir al inicio">
    <img
      class="h-auto w-[72px] object-contain sm:w-[130px] lg:w-[210px]"
      src="/images/logo.png"
      alt="Llajtattoo"
    >
  </a>
  <nav class="hidden items-center gap-4 lg:flex" aria-label="Navegación principal">
    <a href="/" class="font-['Inter',Helvetica] text-sm font-normal text-[#999999] hover:text-black focus:outline-none focus:ring-2 focus:ring-black">Inicio</a>
    <a href="/estilos" class="font-['Inter',Helvetica] text-sm font-normal text-black hover:text-[#999999] focus:outline-none focus:ring-2 focus:ring-black">Estilos</a>
    <a href="/artistas" class="font-['Inter',Helvetica] text-sm font-normal text-black hover:text-[#999999] focus:outline-none focus:ring-2 focus:ring-black">Artistas</a>
    <a href="/unete" class="font-['Inter',Helvetica] text-sm font-normal text-black hover:text-[#999999] focus:outline-none focus:ring-2 focus:ring-black">Únete</a>
    <a href="/blog" class="font-['Inter',Helvetica] text-sm font-normal text-black hover:text-[#999999] focus:outline-none focus:ring-2 focus:ring-black">Blog</a>
  </nav>
  <form class="hidden items-center rounded-full bg-black px-4 py-2 sm:flex" role="search">
    <label for="site-search" class="sr-only">Buscar estilo</label>
    <svg class="mr-2 h-4 w-4 text-white shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
    </svg>
    <input
      id="site-search"
      name="search"
      type="search"
      placeholder="Buscar estilo"
      class="w-24 border-0 bg-transparent font-['Inter',Helvetica] text-xs text-white outline-none placeholder:text-[#999999] lg:w-32"
    >
  </form>
</header>
