---
import Layout from "./Layout.astro";

export interface Props {
  name: string;
  alias: string;
  avatar: string;
  coverImage?: string;
  bio: string;
  styles: string[];
  socials: {
    instagram?: string;
    whatsapp?: string;
    tiktok?: string;
  };
  portfolio: string[];
}

const { name, alias, avatar, coverImage, bio, styles, socials, portfolio } = Astro.props;
---

<Layout title={`${name} (${alias}) | Artista`} currentPage="artistas">
  {/* Hero Header */}
  <header class="relative pt-24 pb-12 bg-black border-b border-[#333]">
    {coverImage && (
      <div class="absolute inset-0 z-0 opacity-40">
        <img src={coverImage} alt="Cover" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent"></div>
      </div>
    )}
    
    <div class="wrap relative z-10 flex flex-col items-center text-center">
      <div class="w-40 h-40 md:w-48 md:h-48 rounded-full overflow-hidden border-4 border-black mb-6 shadow-2xl relative">
        <img src={avatar} alt={name} class="w-full h-full object-cover" />
      </div>
      <h1 class="font-[var(--font-dl)] font-bold text-4xl md:text-5xl lg:text-6xl text-white mb-2">{name}</h1>
      <p class="font-[var(--font-int)] text-lg md:text-xl text-[var(--color-ca)] uppercase tracking-widest font-semibold mb-6">{alias}</p>
      
      <div class="flex flex-wrap justify-center gap-2 mb-8">
        {styles.map(s => (
          <span class="bg-[var(--color-cd)] text-white text-xs font-bold uppercase tracking-wider px-4 py-1.5 rounded-full">{s}</span>
        ))}
      </div>

      <div class="flex gap-4">
        {socials.instagram && (
          <a href={socials.instagram} target="_blank" class="w-12 h-12 rounded-full bg-white text-black flex items-center justify-center hover:bg-[var(--color-ca)] hover:text-white transition-all hover:scale-110">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        )}
        {socials.whatsapp && (
          <a href={socials.whatsapp} target="_blank" class="w-12 h-12 rounded-full bg-white text-black flex items-center justify-center hover:bg-[var(--color-ca)] hover:text-white transition-all hover:scale-110">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </a>
        )}
        {socials.tiktok && (
          <a href={socials.tiktok} target="_blank" class="w-12 h-12 rounded-full bg-white text-black flex items-center justify-center hover:bg-[var(--color-ca)] hover:text-white transition-all hover:scale-110">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12a4 4 0 1 0 4 4V2h3.5a4.5 4.5 0 0 0 4.5 4.5"/></svg>
          </a>
        )}
      </div>
    </div>
  </header>

  <section class="py-16 md:py-20 bg-white">
    <div class="wrap max-w-4xl">
      <div class="bg-[var(--color-cgl)] p-8 md:p-12 rounded-2xl border border-gray-100 mb-16 shadow-sm text-center">
        <h2 class="font-[var(--font-dl)] font-bold text-3xl mb-6 text-black">Sobre Mí</h2>
        <p class="font-[var(--font-int)] text-[var(--color-cm)] text-base md:text-lg leading-relaxed">{bio}</p>
      </div>

      <div>
        <h2 class="font-[var(--font-dl)] font-bold text-4xl mb-10 text-black text-center">Portafolio</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {portfolio.map((img, i) => (
            <div 
              class="aspect-square rounded-xl overflow-hidden bg-[var(--color-cgb)] cursor-pointer group animate-in fade-in zoom-in-95 fill-mode-both"
              style={`animation-delay: ${i * 100}ms;`}
            >
              <img src={img} alt="Tattoo Portfolio" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-black text-white text-center">
    <div class="wrap flex flex-col items-center">
      <h2 class="font-[var(--font-dl)] font-bold text-4xl md:text-5xl mb-6">¿Listo para tatuarte conmigo?</h2>
      <p class="font-[var(--font-int)] text-lg text-[var(--color-cg)] mb-10 max-w-xl mx-auto">
        Puedes agendar una cita directa mandándome un mensaje o contactarme para conversar sobre tu idea.
      </p>
      <a href={socials.whatsapp || "#"} target="_blank" class="bg-white text-black font-[var(--font-int)] font-bold uppercase tracking-wider text-sm px-10 py-4 hover:bg-[var(--color-ca)] hover:text-white transition-colors rounded-full flex items-center gap-3">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        Agendar Cita
      </a>
    </div>
  </section>
</Layout>
