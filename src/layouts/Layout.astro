---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  currentPage?: string;
  /** "dark" invierte los colores de Navbar y Footer (vistas de perfil) */
  theme?: "light" | "dark";
}
const { title, currentPage, theme = "light" } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Comunidad de tatuadores de Cochabamba, Bolivia. Encuentra artistas, estilos y agenda tu próxima cita." />
    <title>{title} | Llajtattoo | Comunidad de tatuadores</title>
    <link rel="icon" href="/favicon.svg" />
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        corePlugins: { preflight: false },
        theme: {
          extend: {
            boxShadow: {
              "m3-elevation-light-5": "var(--m3-elevation-light-5)"
            }
          }
        },
        plugins: []
      };
    </script>
  </head>
  <body class="m-0 min-h-screen bg-[#ffffff] font-['Inter',Helvetica,sans-serif] text-black antialiased flex flex-col justify-between">
    <Navbar currentPage={currentPage} theme={theme} />
    <main class="w-full flex-1">
      <slot />
    </main>
    <Footer theme={theme} />
  </body>
</html>
