---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import StarRating from "../components/StarRating.tsx";

export interface Props {
  title: string;
  currentPage?: string;
}
const { title, currentPage } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Comunidad de tatuadores de Cochabamba, Bolivia. Encuentra artistas, estilos y agenda tu próxima cita." />
    <title>{title} | Llajtattoo | Comunidad de tatuadores</title>
    <link rel="icon" href="/favicon.svg" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        corePlugins: { preflight: false },
        theme: { extend: {} },
        plugins: []
      };
    </script>
  </head>
  <body class="m-0 bg-white text-black">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
